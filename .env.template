# COMPOSE_FILE=docker-compose.yml:docker-compose-dev.yml:docker-compose-qr-shortener.yml:docker-compose-rustfs.yml:docker-compose-superset.yml

# [ip]:port
WEB_BIND=
SHORTNER_BIND=

URL_SHORTNER_PUBLIC=

GEOCODER_URL=http://localhost:8081/0.1
GEOCODER_API_KEY=demo
ROUTER_URL=http://localhost:8082/0.1
ROUTER_API_KEY=demo
OPTIMIZER_URL=http://localhost:8083/0.1
OPTIMIZER_API_KEY=demo
# Restrict the solvers reachable through OPTIMIZER-API: vroom,ortools,pyvrp
AVAILABLE_SOLVERS=
SENTRY_DSN=http://public:secret@example.com/project-id

# Transactional SMTP (ActionMailer). Provider: brevo | mailgun | postmark | sendgrid | ses
SMTP_PROVIDER=
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USER_NAME=robot@example.com
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=true
SMTP_DEFAULT_FROM=root@localhost
# smtp (default in Docker) | letter_opener_web (preview at /letter_opener)
# Compose reads the repo-root .env (not .devcontainer/.env).
# SMTP_DELIVERY_METHOD=smtp



HERE_MAP_APIKEY=

PUMA_WORKERS=0:1 # Prod eg. 1:4
DELAYED_JOB_REPLICAS=1 # prod eg. 4
DELAYED_JOB_OPTIMIZER_REPLICAS=1 # prod eg. 4

SUPERSET_MAPBOX_API_KEY=

LOG_FORMAT= # json

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Superset admin values are only used at superset initialization
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@superset.com
SUPERSET_ADMIN_PASSWORD=admin

SOPAC_RABBITMQ_HOST=rabbitmq-lb.bluconsole.com
SOPAC_RABBITMQ_VHOST=blu-vhost
SOPAC_BROKER_ORG_PREFIX=/SOPAC

# Action Cable (Turbo Streams). REDIS_HOST is also set in the image.
# REDIS_URL=redis://redis-cache:6379/1
# REDIS_HOST=redis-cache

RUSTFS_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=planner-photos
RUSTFS_REGION=eu-west-3
