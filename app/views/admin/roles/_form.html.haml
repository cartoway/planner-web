= bootstrap_form_for [:admin, @role], layout: :horizontal, builder: BootstrapForm::V2FormBuilder, label_col: 'col-md-10 offset-md-1 fw-bold', control_col: 'col-md-10 offset-md-1 field', html: { id: 'role-form-sidebar', class: 'form-horizontal form-sidebar-form form-sidebar-form--full-bleed', data: { turbo_frame: 'form_sidebar', v2__dirty_form_submit_target: 'form' } } do |f|
  = hidden_field_tag :v2_sidebar, '1'
  = render 'shared/error_messages', model: @role
  %fieldset#role-details
    = f.text_field :name, required: true
    = f.text_field :ref, help: t('.ref_help')
    = f.color_field :color, help: t('.color_help')
    .mb-3.row
      %label.col-form-label.col-md-10.offset-md-1.fw-bold{for: 'role_icon'}= t('activerecord.attributes.role.icon')
      .col-md-10.offset-md-1.field
        = select_tag 'role[icon]', grouped_options_for_select([[t('roles.form.prefered_icons'), @grouped_role_icons[0]], [t('roles.form.other_icons'), @grouped_role_icons[1]]], @role.icon), include_blank: t('web.form.default', n: 'fa-hammer'), class: 'form-select', id: 'role_icon', data: { controller: 'v2--tom-select', v2__tom_select_simple_value: true }
        %p.form-text= t('admin.roles.form.icon_help')
  = render 'permissions'
