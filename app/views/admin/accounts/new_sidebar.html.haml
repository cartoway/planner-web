-# Copyright © Cartoway
- locked_customer = @locked_customer
- return_to_customer_id = params[:return_to_customer_id].presence || locked_customer&.id
- mode = (@mode.presence || params[:mode].presence || 'new').to_s
- mode = 'new' unless %w[new existing].include?(mode)
= turbo_frame_tag "form_sidebar" do
  = render 'admin/accounts/sidebar_header', title: (mode == 'existing' ? t('admin.accounts.new.title_existing') : t('admin.accounts.new.title')), return_to_customer_id: return_to_customer_id
  .sidebar-form{ data: { controller: "v2--dirty-form-submit" } }
    = form_with url: admin_accounts_path, method: :post, id: 'account-form-sidebar', class: 'form-horizontal form-sidebar-form form-sidebar-form--full-bleed', data: { turbo_frame: 'form_sidebar', v2__dirty_form_submit_target: 'form' } do
      = hidden_field_tag :v2_sidebar, '1'
      = hidden_field_tag :mode, mode
      - if return_to_customer_id.present?
        = hidden_field_tag :return_to_customer_id, return_to_customer_id
      = render 'shared/error_messages', model: @account
      .mb-3
        = label_tag :customer_id, t('admin.accounts.form.customer'), class: 'form-label'
        - if locked_customer
          = hidden_field_tag :customer_id, locked_customer.id
          %p.form-control-plaintext.mb-0= locked_customer.name
        - else
          = select_tag :customer_id, options_from_collection_for_select(@customers, :id, :name), include_blank: true, required: true, class: 'form-select', data: { controller: 'v2--tom-select', v2__tom_select_simple_value: true }
      - if mode == 'existing'
        .mb-3
          = label_tag :existing_account_id, t('admin.accounts.form.existing_account'), class: 'form-label'
          = select_tag :existing_account_id, options_for_select(@attachable_account_options || [], params[:existing_account_id]), include_blank: true, required: true, class: 'form-select', data: { controller: 'v2--tom-select', v2__tom_select_simple_value: true }
      - else
        .mb-3
          = label_tag 'account_email', t('admin.accounts.form.email'), class: 'form-label'
          = email_field_tag 'account[email]', @account.email, required: true, class: 'form-control', id: 'account_email'
        .mb-3
          = label_tag 'account_name', t('admin.accounts.form.name'), class: 'form-label'
          = text_field_tag 'account[name]', @account.name, class: 'form-control', id: 'account_name'
        .mb-3
          = label_tag 'account_phone', t('admin.accounts.form.phone'), class: 'form-label'
          = telephone_field_tag 'account[phone]', @account.phone, class: 'form-control', id: 'account_phone'
        .mb-3
          = label_tag 'account_time_zone', t('admin.accounts.form.time_zone'), class: 'form-label'
          = select_tag 'account[time_zone]', time_zone_options_for_select(@account.time_zone), include_blank: true, class: 'form-select', id: 'account_time_zone'
      .mb-3
        = label_tag :role_id, t('admin.accounts.form.role'), class: 'form-label'
        = select_tag :role_id, options_from_collection_for_select(@roles, :id, :name), include_blank: t('admin.accounts.form.role_blank'), class: 'form-select'
      - if mode == 'new'
        .form-check.mb-3
          = check_box_tag :send_email, '1', false, class: 'form-check-input', id: 'account_send_email'
          = label_tag :account_send_email, t('admin.accounts.form.send_email'), class: 'form-check-label'
    .form-submit-bar.is-hidden{ data: { "v2--dirty-form-submit-target": "bar" } }
      %button.btn.btn-primary{ type: "submit", form: "account-form-sidebar" }= mode == 'existing' ? t('admin.accounts.form.attach') : t('helpers.submit.create', model: Account.model_name.human)
