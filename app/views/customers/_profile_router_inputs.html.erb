<% if current_user.admin? %>
  <% if has_vehicle_with_unauthorized_router(@customer) %>
    <div class="row">
      <div class="col-md-offset-2 col-md-8">
        <p class="vwarning has-warning"><%= t('customers.form.vehicle_router_unauthorized', profile: @customer.profile.name).html_safe %></p>
      </div>
    </div>
  <% end %>
  <% if has_user_with_unauthorized_layer(@customer) %>
    <div class="row">
      <div class="col-md-offset-2 col-md-8">
        <p class="warning has-warning"><%= t('customers.form.user_layer_unauthorized', profile: @customer.profile.name).html_safe %></p>
      </div>
    </div>
  <% end %>
<% else %>
  <%= hidden_field :customer, :profile_id %>
<% end %>

<div id="customer_router_input" class="row customer-router-select<%= ' customer-router-select--profiles' if current_user.admin? %>">
  <label class="col-md-offset-2 col-md-8" for="customer_router"><%= t('activerecord.attributes.customer.router') %></label>
  <div class="col-md-offset-2 col-md-8 field">
    <div class="input-group">
      <%= select_tag 'customer[router]',
        grouped_options_for_select(
          customer_router_grouped_options(@customer, admin: current_user.admin?),
          customer_router_selected_value(@customer, admin: current_user.admin?)
        ),
        class: 'form-control select2',
        required: true,
        id: 'customer_router' %>
      <span class="input-group-addon"><i class="fa fa-gear fa-fw"></i></span>
    </div>
    <p class="help-block"><%= t('customers.form.router_help') %></p>
    <% unless current_user.admin? %>
      <p class="help-block router-unauthorized hidden warning has-warning"><%= t('activerecord.attributes.customer.router_warning') %></p>
    <% end %>
  </div>
</div>
