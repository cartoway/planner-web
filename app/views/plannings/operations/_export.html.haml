- if @manage_planning[:manage_export] || @manage_planning[:manage_print]
  - export_dis = @manage_planning[:disable_planning_export]
  - if @manage_planning[:manage_export]
    .dropdown.btn-group
      - if export_dis
        %span.btn.btn-default.btn-sm.right.export.disabled
          %i.fa.fa-share-nodes
          %span.caret
      - else
        %a.btn.btn-default.btn-sm.right.export.dropdown-toggle{"data-toggle" => "dropdown", title: t('plannings.edit.exports'), type: "button"}
          %i.fa.fa-share-nodes
          %span.caret
      - unless export_dis
        %ul.dropdown-menu
          %li.dropdown-header
            %h5
              = t('plannings.edit.all_plannings_related')
          %hr
          - if @callback_button
            %li{class: [('disabled' if @manage_planning[:disable_external_callback]), 'link', 'customer_external_callback_url'].compact.join(' '), data: { customer_id: current_user.customer.id, planning_id: @planning.id } }
              %i.fa.fa-desktop.fa-fw
              = current_user.customer.external_callback_name || t('plannings.edit.customer_external_callback_url.action')
            %li.divider{role: "separator"}
          %li
            = link_to api_web_v01_print_planning_path(@planning), target: :_blank do
              %i.fa.fa-print.fa-fw
              = t('plannings.edit.export.print')
          %li.divider{role: "separator"}
          %li
            %a.export_spreadsheet
              %i.fa.fa-table.fa-fw
              = t('plannings.edit.export.spreadsheet')
          %li
            %a.export_summary_spreadsheet{href: '#'}
              %i.fa.fa-table.fa-fw
              = t('plannings.edit.export.summary_spreadsheet')
          %li.divider{role: "separator"}
          %li
            = link_to api_planning_calendar_path(@planning, api_key: current_user.api_key) do
              %i.fa.fa-calendar.fa-fw
              = t('plannings.edit.export.icalendar.action')
  - elsif @manage_planning[:manage_print]
    - if export_dis
      %span.btn.btn-default.btn-sm.disabled{title: t('plannings.edit.export.print')}
        %i.fa.fa-print.fa-fw
    - else
      = link_to api_web_v01_print_planning_path(@planning), class: 'btn btn-default btn-sm', title: t('plannings.edit.export.print'), target: :_blank do
        %i.fa.fa-print.fa-fw
