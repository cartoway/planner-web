- assignable_routes = @planning.routes.select { |route| route.vehicle_usage_id.present? }
- publishable_routes = assignable_routes.select { |route| route.route_data&.size_active.to_i.positive? }
- operation_date = Date.current + @planning.customer.operation_date_offset_default
- taken_by_date = @planning.open_taken_routes_by_date
- selected_ids = publishable_routes.reject(&:hidden).map(&:id)
- route_skills_by_id = publishable_routes.to_h { |route| [route.id, route.route_skills] }
- filter_tag_ids = route_skills_by_id.values.flatten.map(&:id).uniq
- filter_tags = @planning.customer.tags.select { |tag| filter_tag_ids.include?(tag.id) }.map { |tag| { id: tag.id, label: tag.label, color: tag.default_color, icon: tag.default_icon } }
- checklist_items = publishable_routes.map do |route|
  - stops = route.route_data&.size_active.to_i
  - skills = route_skills_by_id[route.id] || []
  - label = [route.ref, route.vehicle_usage&.vehicle&.name].compact.join(' ').presence || "##{route.id}"
  - filter_label = [label, route.ref, route.vehicle_usage&.vehicle&.name, route.vehicle_usage&.vehicle&.ref, *skills.map(&:label)].compact.map { |part| part.to_s.downcase }.uniq.join(' ')
  - { id: route.id, label: label, checked: selected_ids.include?(route.id), filter_label: filter_label, data: { stops: stops, hidden: route.hidden.to_s, tag_ids: skills.map(&:id).join(',') } }
- checklist_actions = [{ mode: 'all', label: t('web.select2.route_all'), icon_class: 'fa fa-check-square fa-fw' }, { mode: 'clear', label: t('web.select2.route_clear'), icon_class: 'fa fa-regular fa-square fa-fw' }, { mode: 'reverse', label: t('web.select2.route_reverse'), icon_class: 'fa fa-random fa-fw' }, { mode: 'visible', label: t('execution.modal.select_visible'), icon_class: 'fa fa-eye fa-fw' }]
#planning-operation-modal.modal.fade{ role: 'dialog', tabindex: '-1', data: { taken_by_date: taken_by_date.to_json, already_in_template: t('execution.modal.already_in', name: '__NAME__'), stops_count_one: t('execution.modal.stops_count.one'), stops_count_other: t('execution.modal.stops_count.other') } }
  .modal-dialog
    .modal-content
      = form_with url: publish_operation_planning_path(@planning), method: :post, local: true do
        .modal-header
          %button.close{ type: 'button', 'data-dismiss': 'modal' }
            &times;
          %h4.modal-title
            %i.fa.fa-play.fa-fw
            = t('execution.modal.title')
        .modal-body
          .form-group
            = label_tag :name, t('execution.modal.name')
            = text_field_tag :name, @planning.name, class: 'form-control', required: true
          .form-group
            = label_tag :date, t('execution.date')
            = date_field_tag :date, operation_date, class: 'form-control', required: true, id: 'execution-operation-date'
          .form-group
            = label_tag nil, t('execution.modal.routes')
            %p.help-block= t('execution.modal.routes_with_stops_only')
            = render 'shared/searchable_checklist_dropdown', id: 'execution-route-selector', id_prefix: 'execution_route_selector', checkbox_name: nil, items: checklist_items, filter_tags: filter_tags, global_actions: checklist_actions, wrapper_class: 'planning-execution-route-selector'
            %ul.list-unstyled.planning-execution-routes
              - publishable_routes.each do |route|
                - label = [route.ref, route.vehicle_usage&.vehicle&.name].compact.join(' ').presence || "##{route.id}"
                - stops = route.route_data&.size_active.to_i
                - default_on = selected_ids.include?(route.id)
                %li.planning-execution-route{ class: ('hidden' unless default_on), data: { route_id: route.id, hidden: route.hidden.to_s, default_on: default_on.to_s, stops: stops } }
                  .planning-execution-route-row
                    .form-switch
                      = check_box_tag 'route_ids[]', route.id, default_on, id: "execution_route_#{route.id}", class: 'execution-route-checkbox form-check-input', data: { hidden: route.hidden.to_s, stops: stops }
                    %label{ for: "execution_route_#{route.id}" }
                      = label
                      %span.text-muted.execution-route-stops= t('execution.modal.stops_count', count: stops)
                  %span.help-block.execution-route-taken-hint.hidden
                  .planning-execution-route-extras
            %p.help-block#execution-route-count{ data: { template: t('execution.modal.selected_count') } }
        .modal-footer
          %button.btn.btn-default{ type: 'button', 'data-dismiss': 'modal' }= t('all.verb.dismiss')
          = submit_tag t('execution.publish'), class: 'btn btn-primary', id: 'execution-publish-submit'
