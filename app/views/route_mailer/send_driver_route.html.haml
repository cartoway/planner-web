%table.w320{cellpadding: "0", cellspacing: "0", width: "600"}
  %tr
    %td{width: "50"}
    %td{align: "center", width: "1000"}
      %div{align: "justify"}
        %p= t('.hello') + ','
        %p= t('.content', s: customer.reseller.name)
        %br
        %ul
          - vehicle_name = local_assigns[:vehicle_name] || route.vehicle_usage.vehicle.name
          - planning_name = local_assigns[:planning_name] || route.planning.name
          - planning_date = local_assigns.key?(:planning_date) ? local_assigns[:planning_date] : route.planning.date
          %li
            = t('.vehicle', name: vehicle_name)
          %li
            = t('.planning', name: planning_name, date: planning_date ? "#{l(planning_date)}" : '')
          %li
            - if mobile_url.present?
              = t('.link', link: mobile_url).html_safe
        %br
        %p
          = I18n.t('user_mailer.layout.staff.greetings').html_safe
        %p.signature
          = I18n.t('user_mailer.layout.staff.signature', name: customer.reseller.name).html_safe
    %td{width: "50"}
- content_for :footer do
  %td{align: "center", class: "white-background", height: "100px", valign: "top", width: "100%", style: "border-top: 1px solid #e5e5e5, border-bottom: 1px solid #e5e5e5" }
