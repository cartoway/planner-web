- montserrat = Rails.root.join('app/assets/fonts/Montserrat.ttf')
!!!
%html{lang: I18n.locale.to_s}
  %head
    %meta{charset: 'utf-8'}
    %title= content_for?(:title) ? yield(:title) : t('stops.delivery_note.title')
    - if montserrat.exist?
      :css
        @font-face {
          font-family: 'Montserrat';
          src: url('app/assets/fonts/Montserrat.ttf') format('truetype');
        }
    %style= File.read(Rails.root.join('app/assets/stylesheets/v2/delivery_note_pdf.css')).html_safe
  %body.print-layout.cartoway-v2{data: { action: 'delivery_note' }}
    = yield
