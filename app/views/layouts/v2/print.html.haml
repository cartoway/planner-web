!!!
%html{lang: I18n.locale.to_s}
  %head
    %meta{content: 'text/html; charset=UTF-8', 'http-equiv': 'Content-Type'}/
    %meta{charset: 'utf-8'}/
    %title= [content_for?(:title) ? yield(:title) : nil, @reseller&.name].compact.join(' – ')
    %link{rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css', crossorigin: 'anonymous'}
    = stylesheet_link_tag 'v2/application', media: 'all'
    %style= File.read(Rails.root.join('app/assets/stylesheets/v2/delivery_note.css')).html_safe
  %body.print-layout.cartoway-v2{'data-controller': controller.controller_path.tr('/', '_'), 'data-action': controller.action_name}
    = yield
