-# Copyright © Cartoway
-# Minimal shell for Lookbook previews: v2 typography (Montserrat, 13px root) + Bootstrap 5 (no legacy application.css).
!!!
%html{lang: I18n.locale}
  %head
    %meta{charset: 'utf-8'}/
    %meta{content: 'width=device-width, initial-scale=1.0', name: 'viewport'}/
    %title Lookbook – Cartoway
    = csrf_meta_tags
    %link{rel: 'preconnect', href: 'https://fonts.googleapis.com'}
    %link{rel: 'preconnect', href: 'https://fonts.gstatic.com', crossorigin: 'anonymous'}
    %link{rel: 'stylesheet', href: 'https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap'}
    %link{rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css', integrity: 'sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB', crossorigin: 'anonymous'}
    %link{rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css', crossorigin: 'anonymous'}
    = stylesheet_link_tag 'v2/layout_bootstrap_overrides', media: 'all', debug: false
    = stylesheet_link_tag 'lookbook_preview', media: 'all'
    = javascript_importmap_tags 'lookbook_entry'
  %body{'data-controller': 'lookbook-v2'}
    = yield
    %script{src: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js', integrity: 'sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI', crossorigin: 'anonymous', defer: true}
