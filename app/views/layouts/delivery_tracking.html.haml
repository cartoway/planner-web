!!!
%html{lang: I18n.locale}
  %head
    %meta{charset: 'utf-8'}
    %meta{content: 'width=device-width, initial-scale=1.0', name: 'viewport'}
    %meta{name: 'robots', content: 'noindex, nofollow'}
    - content_for :meta do
      - unless @terminal
        %meta{name: 'turbo-refresh-method', content: 'morph'}
        %meta{name: 'turbo-refresh-scroll', content: 'preserve'}
    = yield :meta
    %title= content_for?(:title) ? yield(:title) : t('delivery_trackings.show.title')
    = csrf_meta_tags
    / Same stack as v2: Bootstrap 5 + MapLibre CDN + Hotwire via importmap
    %link{rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css', integrity: 'sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB', crossorigin: 'anonymous'}
    = stylesheet_link_tag 'delivery_tracking', media: 'all', debug: false
    %link{rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/dist/maplibre-gl.css', crossorigin: 'anonymous'}
    %script{src: 'https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/dist/maplibre-gl.min.js', crossorigin: 'anonymous'}
    = javascript_importmap_tags
  %body.delivery-tracking-body
    = yield
