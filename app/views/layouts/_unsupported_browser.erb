<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <% reseller_name = @reseller.name %>
    <title><%= [yield(:title), reseller_name].select{ |t| !t.empty? }.join(' – ') %></title>
    <%= csrf_meta_tags %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track' => true %>

    <%= favicon_link_tag 'apple-touch-57.png', rel: 'apple-touch-icon', type: 'image/png' %>
    <%= favicon_link_tag 'apple-touch-72.png', rel: 'apple-touch-icon', type: 'image/png', sizes: '72x72' %>
    <%= favicon_link_tag 'apple-touch-114.png', rel: 'apple-touch-icon', type: 'image/png', sizes: '114x114' %>
    <%= favicon_link_tag 'apple-touch-144.png', rel: 'apple-touch-icon', type: 'image/png', sizes: '144x144' %>
    <%= favicon_link_tag @reseller.favicon.url || 'favicon.ico', rel: 'shortcut icon' %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
