-# Accounts list + pagination — Turbo Frame partial updates (see admin/accounts#index).
-# Count lives inside the frame so server-side search refreshes total with the list.
= turbo_frame_tag 'accounts_list', data: { per_page: @pagination[:per_page], page: @pagination[:page], controller: 'v2--table-selection v2--index-selection', v2__index_selection_select_label_value: t('all.verb.select'), v2__index_selection_cancel_label_value: t('all.verb.cancel') } do
  .destinations-sidebar-counts.px-3.pt-3
    = render 'v2/shared/index_count', count: @pagination[:total], help: t('admin.accounts.index.count_help'), model_key: 'admin.accounts.count', nowrap: true, filterable: false
  = form_tag admin_accounts_path, method: :delete, id: 'accounts-destroy' do
    .destinations-list-toolbar.d-flex.justify-content-between.align-items-center.mb-2.px-3.pt-2.pb-2.flex-wrap.gap-2
      .destinations-list-toolbar-actions.d-flex.gap-1.align-items-center.flex-wrap
        = link_to new_admin_account_path, class: 'btn btn-primary', title: t('admin.accounts.index.new'), data: { turbo_frame: 'form_sidebar', turbo_prefetch: 'false' } do
          %i.fa.fa-plus.fa-fw
          %span.destinations-toolbar-label= t('admin.accounts.index.new')
        %button.btn.btn-outline-secondary{type: 'button', title: t('all.verb.select'), data: { action: 'v2--index-selection#toggle' }}
          %i.fa.fa-check-square.fa-fw{"aria-hidden": "true"}
          %span.destinations-toolbar-label{data: { v2__index_selection_target: 'toggleLabel' }}= t('all.verb.select')
        %button.btn.btn-danger.destinations-bulk-delete{type: 'button', disabled: true, title: t('all.verb.destroy_selection'), data: confirm_click_destroy_data(group: 'accounts-destroy', form: 'accounts-destroy').merge(v2__table_selection_target: 'bulk')}
          %i.fa.fa-trash.fa-fw
          %span.destinations-toolbar-label= t('all.verb.destroy_selection')
      .destinations-list-toolbar-meta.d-flex.gap-1.align-items-center.flex-wrap.ms-auto
        .dropdown
          %button.btn.btn-light.dropdown-toggle{type: 'button', data: { 'bs-toggle': 'dropdown' }, 'aria-expanded': 'false', title: t('all.misc.per_page')}
            %i.fa.fa-list-ol.fa-fw
            %span.destinations-toolbar-label= "#{@pagination[:per_page]} #{t('all.misc.per_page')}"
          %ul.dropdown-menu.dropdown-menu-end
            - accounts_index_per_page_options.each do |option|
              %li
                = link_to admin_accounts_path(accounts_index_params(page: 1, per_page: option)),
                  class: "dropdown-item#{' active' if @pagination[:per_page] == option}",
                  data: { turbo_frame: 'accounts_list', turbo_action: 'advance', per_page: option } do
                  = "#{option} #{t('all.misc.per_page')}"
    = render 'v2/admin/accounts/list_body'
