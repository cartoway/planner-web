-# Copyright © Cartoway
-# Roles list — Turbo Frame partial updates (see admin/roles#index).
-# Count lives inside the frame so server-side search refreshes total with the list.
= turbo_frame_tag 'roles_list', data: { controller: 'v2--table-selection v2--index-selection', v2__index_selection_select_label_value: t('all.verb.select'), v2__index_selection_cancel_label_value: t('all.verb.cancel') } do
  .destinations-sidebar-counts.px-3.pt-3
    = render 'v2/shared/index_count', count: @roles.size, help: t('admin.roles.index.count_help'), model_key: 'activerecord.models.roles', nowrap: true, filterable: false
  = form_tag admin_roles_path, method: :delete, id: 'roles-destroy' do
    .destinations-list-toolbar.d-flex.justify-content-between.align-items-center.mb-2.px-3.pt-2.pb-2.flex-wrap.gap-2
      .destinations-list-toolbar-actions.d-flex.gap-1.align-items-center.flex-wrap
        = link_to new_admin_role_path, class: 'btn btn-primary', title: t('admin.roles.index.new'), data: { turbo_frame: 'form_sidebar', turbo_prefetch: 'false' } do
          %i.fa.fa-plus.fa-fw
          %span.destinations-toolbar-label= t('admin.roles.index.new')
        %button.btn.btn-outline-secondary{type: 'button', title: t('all.verb.select'), data: { action: 'v2--index-selection#toggle' }}
          %i.fa.fa-check-square.fa-fw{"aria-hidden": "true"}
          %span.destinations-toolbar-label{data: { v2__index_selection_target: 'toggleLabel' }}= t('all.verb.select')
        %button.btn.btn-danger.destinations-bulk-delete{type: 'button', disabled: true, title: t('all.verb.destroy_selection'), data: confirm_click_destroy_data(group: 'roles-destroy', form: 'roles-destroy').merge(v2__table_selection_target: 'bulk')}
          %i.fa.fa-trash.fa-fw
          %span.destinations-toolbar-label= t('all.verb.destroy_selection')
    #role_box.destinations-list-scroll
      .v2-index-cards.px-2{data: { v2__index_selection_target: 'root' }}
        .v2-index-cards-select-bar
          %label.mb-0.d-flex.align-items-center.gap-2
            %input{type: 'checkbox', data: { v2__table_selection_target: 'all', action: 'change->v2--table-selection#toggleAll' }}
            %span= t('all.verb.select_all')
        #roles-list
          - @roles.each do |role|
            = render 'v2/admin/roles/list_row', role: role, user_count: @user_counts_by_role_id[role.id] || 0
