- include_past = params[:include_past].present?
- stops = visit_operation_stops(visit, include_past: include_past)
- if stops.any?
  .related-list
    %h6.related-list-title= t('operations.form.title')
    - stops.each do |stop|
      = render 'v2/operation_stops/row', stop: stop, docs_prefix: "visit-#{visit.id}-op-stop-#{stop.id}"
