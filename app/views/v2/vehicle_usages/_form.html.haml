-# V2 sidebar fleet form (BS5). No Paloma/jQuery — Stimulus + Tom Select only.
- form_html = { class: 'number-to-percentage form-horizontal', id: 'vehicle-usage-form-sidebar', 'data-turbo-frame' => 'form_sidebar', 'data-controller' => 'v2--rest-type-fields v2--router-options v2--number-to-percentage v2--vehicle-devices', 'data-action' => 'change->v2--rest-type-fields#change change->v2--router-options#change submit->v2--rest-type-fields#submit submit->v2--number-to-percentage#submit', 'data-v2--rest-type-fields-prefix-value' => 'vehicle_usage', 'data-v2--number-to-percentage-prefix-value' => 'vehicle_usage[vehicle]', 'data-v2--rest-type-fields-duration-must-be-filled-value' => t('vehicle_usages.form.rest_type.duration_must_be_filled'), 'data-v2--rest-type-fields-lapse-must-be-filled-value' => t('vehicle_usages.form.rest_type.lapse_must_be_filled'), 'data-v2--rest-type-fields-duration-must-be-smaller-value' => t('vehicle_usages.form.rest_type.duration_must_be_smaller') }
- form_html['data-v2-js-config'] = local_assigns[:v2_js_config] if local_assigns[:v2_js_config]
- tom_select_data = { controller: 'v2--tom-select', v2__tom_select_create_value: current_user_form_create?(:tags), v2__tom_select_placeholder_value: t('web.select2.placeholder') }
- v2_label_col = 'col-form-label col-md-10 offset-md-1 fw-bold'
- v2_bootstrap_label_col = 'col-md-10 offset-md-1 fw-bold'
- v2_control_col = 'col-md-10 offset-md-1 field'
= bootstrap_form_for @vehicle_usage, layout: :horizontal, builder: BootstrapForm::V2FormBuilder, label_col: v2_bootstrap_label_col, control_col: v2_control_col, html: form_html do |f|
  = hidden_field_tag :v2_sidebar, '1'
  = render 'shared/error_messages', model: @vehicle_usage
  %fieldset
    %legend.scheduler-border
      %a{"data-parent": "", "data-bs-toggle": "collapse", href: "#collapseVehicle", class: ('collapsed' if @vehicle_usage_sets.count > 1) }
        = t 'vehicle_usages.form.vehicle.legend'
    #collapseVehicle.collapse{ class: ('show' if @vehicle_usage_sets.count < 2)}
    - if @vehicle_usage_sets[0].customer.default_max_vehicle_usage_sets > 1
      %p.help-block
        = t 'vehicle_usages.form.vehicle.help'
    = f.fields_for @vehicle_usage.vehicle, layout: :horizontal, builder: BootstrapForm::V2FormBuilder do |f|
      = f.hidden_field :id
      - if @vehicle_usage.vehicle.customer.enable_references
        = f.text_field :ref, help: t('vehicles.form.ref.help')
      .mb-3.row
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_color"}
          = t('activerecord.attributes.vehicle.color')
        %div{class: v2_control_col}
          = color_field_tag 'vehicle_usage[vehicle][color]', @vehicle_usage.vehicle.color.presence || DEFAULT_COLOR, id: 'vehicle_usage_vehicle_color', class: 'form-control form-control-color', title: t('activerecord.attributes.vehicle.customised_color')
      = f.text_field :name, required: true
      #vehicle_usage_vehicle_consumption_input.mb-3.row.fleet-split
        %label.visually-hidden{for: "vehicle_usage_vehicle_emission"}
          = t 'activerecord.attributes.vehicle.emission'
        %label.visually-hidden{for: "vehicle_usage_vehicle_consumption"}
          = t 'activerecord.attributes.vehicle.consumption'
        %label{class: v2_label_col}
          = t 'activerecord.attributes.vehicle.emission'
          \/ #{t 'activerecord.attributes.vehicle.consumption'}
        %div{class: v2_control_col}
          .input-group.mb-2
            = select 'vehicle_usage[vehicle]', :emission, Vehicle.emissions_hash.values, { include_blank: t('web.form.empty_entry'), selected: @vehicle_usage.vehicle.emission }, class: 'form-control'
            %span.input-group-text
              = t 'all.unit.kgco2e_l_html'
          .input-group
            = text_field 'vehicle_usage[vehicle]', :consumption, value: @vehicle_usage.vehicle.localized_consumption, class: 'form-control'
            %span.input-group-text
              = current_user.prefered_unit == 'mi' ? t('all.unit.l_62Miles') : t('all.unit.l_100km')
          %p.help-block
            = t 'vehicles.form.emissions.help'
            \- #{current_user.prefered_unit == 'mi' ? t('vehicles.form.consumption.help_miles') : t('vehicles.form.consumption.help')}

      #vehicle_usage_vehicle_max_distance.row
        %label.visually-hidden{for: "vehicle_usage_vehicle_max_distance"}
          = t 'activerecord.attributes.vehicle.max_distance'
        %label{class: v2_label_col}
          = t 'activerecord.attributes.vehicle.max_distance'
        %div{class: v2_control_col}
          .input-group
            - max_distance = distance_in_user_unit(@vehicle_usage.vehicle.max_distance, @current_user.prefered_unit)
            = number_field 'vehicle_usage[vehicle]',
              :max_distance,
              value: max_distance,
              placeholder: (@vehicle_usage.vehicle_usage_set.max_distance ? t('customers.form.field_default', n: distance_in_user_unit(@vehicle_usage.vehicle_usage_set.max_distance, @current_user.prefered_unit)) : ''),
              step: 'any', class: 'form-control', min: 0
            %span.input-group-text
              = current_user.prefered_unit == 'mi' ? t('all.unit.miles') : t('all.unit.kms')
          %p.help-block= current_user.prefered_unit == 'mi' ? t('vehicles.form.max_distance.help_miles') : t('vehicles.form.max_distance.help')
      #vehicle_usage_vehicle_max_ride_distance_input.row
        %label.visually-hidden{for: "vehicle_usage_vehicle_max_ride_distance"}= t 'activerecord.attributes.vehicle.max_ride_distance'
        %label{class: v2_label_col}= t 'activerecord.attributes.vehicle.max_ride_distance'
        %div{class: v2_control_col}
          .input-group
            - max_ride_distance = distance_in_user_unit(@vehicle_usage.vehicle.max_ride_distance, @current_user.prefered_unit)
            = number_field 'vehicle_usage[vehicle]',
              :max_ride_distance,
              value: max_ride_distance ,
              placeholder: @vehicle_usage.vehicle_usage_set.max_ride_distance ? t('customers.form.field_default', n: distance_in_user_unit(@vehicle_usage.vehicle_usage_set.max_ride_distance, @current_user.prefered_unit)) : '',
              step: 'any',
              class: 'form-control', min: 0
            %span.input-group-text= current_user.prefered_unit == 'mi' ? t('all.unit.miles') : t('all.unit.kms')
          %p.help-block= current_user.prefered_unit == 'mi' ? t('vehicles.form.max_ride_distance.help_miles') : t('vehicles.form.max_ride_distance.help')
      #vehicle_usage_vehicle_max_ride_duration_input.row
        %label.visually-hidden{for: "vehicle_usage_vehicle_max_ride_duration"}= t 'activerecord.attributes.vehicle.max_ride_duration'
        %label{class: v2_label_col}= t 'activerecord.attributes.vehicle.max_ride_duration'
        %div{class: v2_control_col}
          .input-group
            = text_field 'vehicle_usage[vehicle]', :max_ride_duration, value: @vehicle_usage.vehicle.max_ride_duration_time,
              placeholder: @vehicle_usage.vehicle_usage_set.max_ride_duration ? t('customers.form.field_default', n: @vehicle_usage.vehicle_usage_set.max_ride_duration_time) : t('all.unit.hour_minute'),
              class: 'form-control'
            %span.input-group-text
              %i.fa.fa-stopwatch.fa-fw
          %p.help-block= t 'vehicles.form.max_ride_duration.help'
      = f.fields_for 'vehicle_usage[vehicle][capacities]',@vehicle_usage.vehicle.capacities, layout: :horizontal, builder: BootstrapForm::V2FormBuilder do |capacity|
        #vehicle_usage_vehicle_capacity_input.row{ class: ("has-error" if @vehicle_usage.vehicle.errors.messages[:capacities].present?)}
          %label{class: v2_label_col}
            = t 'vehicles.form.capacities.label'
          %div{class: v2_control_col}
            - @vehicle_usage.vehicle.customer.deliverable_units.each do |du|
              .input-group
                = number_field 'vehicle_usage[vehicle][capacities]', du.id, value: @vehicle_usage.vehicle.capacities && @vehicle_usage.vehicle.capacities[du.id], placeholder: du.default_capacity && t('vehicles.form.capacities.default', n: du.localized_default_capacity), class: 'form-control width_1_2', step: 'any', min: 0
                = text_field 'vehicle_usage[vehicle][capacities_unit]', du.id, value: du.label ? du.label + (du.default_optimization_overload_multiplier == 0 ? t('vehicles.form.capacities.no_overload') : du.default_optimization_overload_multiplier == -1 ? t('vehicles.form.capacities.ignore_overload') : '') : du.label, class: 'form-control width_1_2', placeholder: t('deliverable_units.form.label_placeholder') + (du.default_optimization_overload_multiplier == 0 ? t('vehicles.form.capacities.no_overload') : du.default_optimization_overload_multiplier == -1 ? t('vehicles.form.capacities.ignore_overload') : ''), disabled: true
                %span.input-group-text
                  = content_tag('i', '', class: 'fa ' + du.default_icon + ' fa-fw')
            %p.help-block
              = t 'vehicles.form.capacities.help'

      - vehicle_custom_attributes = @vehicle_usage.vehicle.customer.custom_attributes.for_vehicle
      - if vehicle_custom_attributes.any?
        - vehicle_custom_attributes.each do |custom_attribute|
          #vehicle_usage_vehicle_custom_attributes_input.row
            %label{class: v2_label_col}
              = custom_attribute.name
            %div{class: v2_control_col}
              = custom_attribute_form_field(f, @vehicle_usage.vehicle, custom_attribute, 'vehicle_usage[vehicle]')
              %p.help-block
                = custom_attribute.description
      - if @vehicle_usage_sets.count < 2 || (!@vehicle_usage.vehicle.tags.nil? && @vehicle_usage.vehicle.tags.count > 0)
        #vehicle_usage_tag_ids_input
          = f.select :tag_ids, options_for_select(@vehicle_usage.vehicle.customer.tags.map { |tag| [tag.label, tag.id, tag_select_option_attributes(tag)] }, @vehicle_usage.vehicle.tags.collect(&:id)), {label: t('activerecord.attributes.vehicle.tag_ids'), help: t('vehicles.form.tags_help'), append: content_tag('i', '', class: 'fa fa-tags fa-fw') }, {multiple: true, data: tom_select_data}
      #vehicle_router_input.mb-3.row
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router"}
          = t 'activerecord.attributes.vehicle.router'
        %div{class: v2_control_col}
          .input-group
            - router_dimension_label = "activerecord.attributes.router.router_dimensions.#{@vehicle_usage.vehicle.customer.router_dimension}"
            - routers = @vehicle_usage.vehicle.customer.profile.routers
            = select_tag 'vehicle_usage[vehicle][router]', router_grouped_options(routers, @vehicle_usage), include_blank: "#{t('vehicles.form.router.default')} (#{@vehicle_usage.vehicle.customer.router.translated_name} - #{t(router_dimension_label)})", class: 'form-control', id: 'vehicle_usage_vehicle_router'
            %span.input-group-text
              %i.fa.fa-gear.fa-fw
          %p.help-block= t 'vehicles.form.router.help'
      #router_options_traffic_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.traffic? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_traffic"}
          = t('activerecord.attributes.customer.router_options_traffic')
        %div{class: v2_control_col}
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_traffic_yes{name: "vehicle_usage[vehicle][router_options][traffic]", type: "radio", class: 'form-check-input', value: "true", checked: (@vehicle_usage.vehicle.router_options['traffic'] == true ? 'true' : nil)}
            = t('customers.form.router_options_traffic_yes')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_traffic_no{name: "vehicle_usage[vehicle][router_options][traffic]", type: "radio", class: 'form-check-input', value: "false", checked: (@vehicle_usage.vehicle.router_options['traffic'] == false ? 'true' : nil)}
            = t('customers.form.router_options_traffic_no')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_traffic_default{name: "vehicle_usage[vehicle][router_options][traffic]", type: "radio", class: 'form-check-input', value: "", checked: (@vehicle_usage.vehicle.router_options['traffic'].nil? ? 'true' : nil)}
            = t('customers.form.router_options_traffic_default', value: customer_router_boolean_default_label(@vehicle_usage.vehicle.customer, :traffic))
      #router_options_track_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.track? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_track"}
          = t('activerecord.attributes.customer.router_options_track')
        %div{class: v2_control_col}
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_track_yes{name: "vehicle_usage[vehicle][router_options][track]", type: "radio", class: 'form-check-input', value: "true", checked: (@vehicle_usage.vehicle.router_options['track'] == true ? 'true' : nil)}
            = t('customers.form.router_options_track_yes')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_track_no{name: "vehicle_usage[vehicle][router_options][track]", type: "radio", class: 'form-check-input', value: "false", checked: (@vehicle_usage.vehicle.router_options['track'] == false ? 'true' : nil)}
            = t('customers.form.router_options_track_no')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_track_default{name: "vehicle_usage[vehicle][router_options][track]", type: "radio", class: 'form-check-input', value: "", checked: (@vehicle_usage.vehicle.router_options['track'].nil? ? 'true' : nil)}
            = t('customers.form.router_options_track_default', value: customer_router_boolean_default_label(@vehicle_usage.vehicle.customer, :track))

      #router_options_motorway_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.motorway? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_motorway"}
          = t('activerecord.attributes.customer.router_options_motorway')
        %div{class: v2_control_col}
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_motorway_yes{name: "vehicle_usage[vehicle][router_options][motorway]", type: "radio", class: 'form-check-input', value: "true", checked: (@vehicle_usage.vehicle.router_options['motorway'] == true ? 'true' : nil)}
            = t('customers.form.router_options_motorway_yes')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_motorway_no{name: "vehicle_usage[vehicle][router_options][motorway]", type: "radio", class: 'form-check-input', value: "false", checked: (@vehicle_usage.vehicle.router_options['motorway'] == false ? 'true' : nil)}
            = t('customers.form.router_options_motorway_no')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_motorway_default{name: "vehicle_usage[vehicle][router_options][motorway]", type: "radio", class: 'form-check-input', value: "", checked: (@vehicle_usage.vehicle.router_options['motorway'].nil? ? 'true' : nil)}
            = t('customers.form.router_options_motorway_default', value: customer_router_boolean_default_label(@vehicle_usage.vehicle.customer, :motorway))

      #router_options_toll_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.toll? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_toll"}
          = t('activerecord.attributes.customer.router_options_toll')
        %div{class: v2_control_col}
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_toll_yes{name: "vehicle_usage[vehicle][router_options][toll]", type: "radio", class: 'form-check-input', value: "true", checked: (@vehicle_usage.vehicle.router_options['toll'] == true ? 'true' : nil)}
            = t('customers.form.router_options_toll_yes')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_toll_no{name: "vehicle_usage[vehicle][router_options][toll]", type: "radio", class: 'form-check-input', value: "false", checked: (@vehicle_usage.vehicle.router_options['toll'] == false ? 'true' : nil)}
            = t('customers.form.router_options_toll_no')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_toll_default{name: "vehicle_usage[vehicle][router_options][toll]", type: "radio", class: 'form-check-input', value: "", checked: (@vehicle_usage.vehicle.router_options['toll'].nil? ? 'true' : nil)}
            = t('customers.form.router_options_toll_default', value: customer_router_boolean_default_label(@vehicle_usage.vehicle.customer, :toll))

      #router_options_low_emission_zone_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.low_emission_zone? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_low_emission_zone"}
          = t('activerecord.attributes.customer.router_options_low_emission_zone')
        %div{class: v2_control_col}
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_low_emission_zone_yes{name: "vehicle_usage[vehicle][router_options][low_emission_zone]", type: "radio", class: 'form-check-input', value: "true", checked: (@vehicle_usage.vehicle.router_options['low_emission_zone'] == true ? 'true' : nil)}
            = t('customers.form.router_options_low_emission_zone_yes')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_low_emission_zone_no{name: "vehicle_usage[vehicle][router_options][low_emission_zone]", type: "radio", class: 'form-check-input', value: "false", checked: (@vehicle_usage.vehicle.router_options['low_emission_zone'] == false ? 'true' : nil)}
            = t('customers.form.router_options_low_emission_zone_no')
          %label.form-check
            %input#vehicle_usage_vehicle_router_options_low_emission_zone_default{name: "vehicle_usage[vehicle][router_options][low_emission_zone]", type: "radio", class: 'form-check-input', value: "", checked: (@vehicle_usage.vehicle.router_options['low_emission_zone'].nil? ? 'true' : nil)}
            = t('customers.form.router_options_low_emission_zone_default', value: customer_router_boolean_default_label(@vehicle_usage.vehicle.customer, :low_emission_zone))

      #router_options_trailers_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.trailers? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_trailers"}
          = t('activerecord.attributes.customer.router_options_trailers')
        %div{class: v2_control_col}
          .input-group
            = number_field_tag 'vehicle_usage[vehicle][router_options][trailers]', @vehicle_usage.vehicle.router_options['trailers'], { min: 0, max: 4, placeholder: !@vehicle_usage.vehicle.customer.trailers.to_s.empty? ? t('customers.form.router_options_default', n: @vehicle_usage.vehicle.customer.trailers) : '', class: 'form-control' }
            %span.input-group-text
              %i.fa.fa-truck-field.fa-fw
          %p.help-block
            = t('customers.form.router_options_trailers_range', from: 0, to: 4)

      #router_options_weight_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.weight? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_weight"}
          = t('activerecord.attributes.customer.router_options_weight')
        %div{class: v2_control_col}
          .input-group
            = number_field_tag 'vehicle_usage[vehicle][router_options][weight]', @vehicle_usage.vehicle.router_options['weight'], { min: 0, max: 1000, step: 'any', placeholder: !@vehicle_usage.vehicle.customer.weight.to_s.empty? ? t('customers.form.router_options_default', n: @vehicle_usage.vehicle.customer.weight) : '', class: 'form-control' }
            %span.input-group-text= t('all.unit.ton')
          %p.help-block= t('customers.form.router_options_weight_range', from: 0, to: 1000)

      #router_options_weight_per_axle_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.weight_per_axle? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_weight_per_axle"}
          = t('activerecord.attributes.customer.router_options_weight_per_axle')
        %div{class: v2_control_col}
          .input-group
            = number_field_tag 'vehicle_usage[vehicle][router_options][weight_per_axle]', @vehicle_usage.vehicle.router_options['weight_per_axle'], { min: 0, max: 1000, step: 'any', placeholder: !@vehicle_usage.vehicle.customer.weight_per_axle.to_s.empty? ? t('customers.form.router_options_default', n: @vehicle_usage.vehicle.customer.weight_per_axle) : '', class: 'form-control' }
            %span.input-group-text= t('all.unit.ton')
          %p.help-block= t('customers.form.router_options_weight_per_axle_range', from: 0, to: 1000)

      #router_options_height_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.height? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_height"}
          = t('activerecord.attributes.customer.router_options_height')
        %div{class: v2_control_col}
          .input-group
            = number_field_tag 'vehicle_usage[vehicle][router_options][height]', @vehicle_usage.vehicle.router_options['height'], { min: 0, max: 50, step: 'any', placeholder: !@vehicle_usage.vehicle.customer.height.to_s.empty? ? t('customers.form.router_options_default', n: @vehicle_usage.vehicle.customer.height) : '', class: 'form-control' }
            %span.input-group-text= t('all.unit.m')
          %p.help-block= t('customers.form.router_options_height_range', from: 0, to: 50)

      #router_options_width_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.width? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_width"}
          = t('activerecord.attributes.customer.router_options_width')
        %div{class: v2_control_col}
          .input-group
            = number_field_tag 'vehicle_usage[vehicle][router_options][width]', @vehicle_usage.vehicle.router_options['width'], { min: 0, max: 50, step: 'any', placeholder: !@vehicle_usage.vehicle.customer.width.to_s.empty? ? t('customers.form.router_options_default', n: @vehicle_usage.vehicle.customer.width) : '', class: 'form-control' }
            %span.input-group-text= t('all.unit.m')
          %p.help-block= t('customers.form.router_options_width_range', from: 0, to: 50)

      #router_options_length_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.length? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "vehicle_usage_vehicle_router_options_length"}
          = t('activerecord.attributes.customer.router_options_length')
        %div{class: v2_control_col}
          .input-group
            = number_field_tag 'vehicle_usage[vehicle][router_options][length]', @vehicle_usage.vehicle.router_options['length'], { min: 0, max: 300, step: 'any', placeholder: !@vehicle_usage.vehicle.customer.length.to_s.empty? ? t('customers.form.router_options_default', n: @vehicle_usage.vehicle.customer.length) : '', class: 'form-control' }
            %span.input-group-text= t('all.unit.m')
          %p.help-block= t('customers.form.router_options_length_range', from: 0, to: 300)

      #router_options_hazardous_goods_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.hazardous_goods? ? '' : 'router-option-disabled')}
        %label{class: "#{v2_label_col}", for: "customer_router_options_hazardous_goods"}
          = t('activerecord.attributes.customer.router_options_hazardous_goods')
        %div{class: v2_control_col}
          - hazardous_label = !!@vehicle_usage.vehicle.customer.hazardous_goods ? t("activerecord.attributes.router.options.hazardous_goods.#{@vehicle_usage.vehicle.customer.hazardous_goods}") : t('activerecord.attributes.router.options.hazardous_goods_none')
          = select_tag 'vehicle_usage[vehicle][router_options][hazardous_goods]', options_for_select(t('activerecord.attributes.router.options.hazardous_goods').invert, current_router_options(@vehicle_usage.vehicle)['hazardous_goods']), include_blank: "#{t('vehicles.form.router.default')} (#{"activerecord.attributes.router.options.hazardous_goods.#{@vehicle_usage.vehicle.customer.hazardous_goods}"})", class: 'form-control'

      #router_options_max_walk_distance_input.mb-3.row{ class: (@vehicle_usage.vehicle.default_router.max_walk_distance? ? '' : 'router-option-disabled')}
