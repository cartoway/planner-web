-# locals: store, can_destroy:
- address_line = destinations_list_card_address_line(store, %w[street postalcode city])
- geocoded_line = destinations_list_geocoding_result_free(store)
.v2-index-card.store-row.destinations-index-card{id: dom_id(store), data: { store_id: store.id, lat: store.lat, lng: store.lng, v2__table_filter_target: 'row' }}
  .v2-index-card-main
    .v2-index-card-select
      = check_box_tag "stores[#{store.id}]", '1', false, disabled: !can_destroy, data: { v2__table_selection_target: 'row', action: 'change->v2--table-selection#syncBulk' }
    .v2-index-card-body
      .v2-index-card-header.destinations-card-header
        .destinations-card-identity
          - if store.ref.present?
            %span.destinations-card-ref{title: Store.human_attribute_name(:ref)}= store.ref
          %h2.v2-index-card-title.destinations-card-name
            = store_icon store
            = store.name.presence || '–'
        .v2-index-card-badges
          = render 'v2/destinations/list_card_geocoding_chip', destination: store
        .v2-index-card-actions.destinations-card-actions
          %button.btn.btn-light.stores-row-center{type: 'button', disabled: !store.position?, title: t('destinations.index.center_view_help'), 'aria-label': t('destinations.index.center_view_help')}
            %i.fa.fa-expand.fa-fw
          = link_to edit_store_path(store), class: 'btn btn-primary', title: t('all.verb.edit'), 'aria-label': t('all.verb.edit'), data: { turbo_frame: 'form_sidebar', turbo_prefetch: 'false' } do
            %i.fa.fa-pencil.fa-fw
          %button.btn.btn-danger{
            type: 'button',
            disabled: !can_destroy,
            title: t('all.verb.destroy'),
            'aria-label': t('all.verb.destroy'),
            data: (can_destroy ? confirm_click_destroy_data(group: 'stores-destroy', url: store_path(store), ready_label: '<i class="fa fa-check fa-fw" aria-hidden="true"></i>') : {})
          }
            %i.fa.fa-trash.fa-fw
      - if address_line.present? || geocoded_line.present?
        .destinations-card-address-block
          - if address_line.present?
            %p.destinations-card-address= address_line
          - if geocoded_line.present?
            .alert.alert-light.destinations-card-geocoded{title: t('destinations.index.geocoding_result')}
              %i.fa.fa-magnifying-glass.fa-fw.destinations-card-geocoded-icon{"aria-hidden": "true"}
              %span.destinations-card-geocoded-value= geocoded_line
