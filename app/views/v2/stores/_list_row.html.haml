-# locals: store, can_destroy:
%tr.store-row{id: dom_id(store), class: ('table-danger' unless store.position?), data: { store_id: store.id, lat: store.lat, lng: store.lng, v2__table_filter_target: 'row' }}
  %td.destinations-selection-col
    = check_box_tag "stores[#{store.id}]", '1', false, disabled: !can_destroy, data: { v2__table_selection_target: 'row', action: 'change->v2--table-selection#syncBulk' }
  %td.destinations-list-col.stores-list-col--icon= store_icon store
  %td.destinations-list-col.stores-list-col--name
    %span.destinations-list-cell-content
      - unless store.position?
        %i.fa.fa-map-marker.fa-fw
      = store.name
  %td.destinations-list-col.stores-list-col--street
    %span.destinations-list-cell-content= store.street
  %td.destinations-list-col.stores-list-col--city
    %span.destinations-list-cell-content= store.city
  %td.destinations-list-actions-col.text-nowrap
    .btn-group{role: 'group'}
      %button.btn.btn-light.stores-row-center{type: 'button', disabled: !store.position?, title: t('destinations.index.center_view_help'), 'aria-label': t('destinations.index.center_view_help')}
        %i.fa.fa-expand.fa-fw
      = link_to edit_store_path(store), class: 'btn btn-light', data: { turbo_frame: 'form_sidebar', turbo_prefetch: 'false' } do
        %i.fa.fa-pencil.fa-fw
      %button.btn.btn-danger{
        type: 'button',
        disabled: !can_destroy,
        title: t('all.verb.destroy'),
        data: (can_destroy ? confirm_click_destroy_data(group: 'stores-destroy', url: store_path(store)) : {})
      }
        %i.fa.fa-trash.fa-fw

