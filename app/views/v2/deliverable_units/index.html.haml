-# Copyright © Cartoway
- content_for :form_sidebar do
  = render "v2/layouts/form_sidebar_placeholder"
- content_for :title, t('deliverable_units.index.title')
- can_destroy = current_user_form_destroy_enabled?(:deliverable_units)
- can_create = current_user_form_create?(:deliverable_units)
.deliverable-units-index{data: { controller: 'v2--table-filter v2--table-selection' }}
  .deliverable-units-toolbar.px-3.pt-3
    .d-flex.justify-content-between.align-items-center.mb-3.flex-wrap.gap-2
      .d-flex.gap-2.align-items-center
        = link_to new_deliverable_unit_path, class: 'btn btn-primary', disabled: !can_create, data: { turbo_frame: 'form_sidebar', turbo_prefetch: 'false' } do
          %i.fa.fa-plus.fa-fw
          = t 'deliverable_units.index.new'
        %button.btn.btn-danger{
          type: 'button',
          disabled: true,
          title: t('all.verb.destroy_selection'),
          data: confirm_click_destroy_data(
            group: 'deliverable-units-destroy',
            form: 'deliverable-units-destroy',
            ready_label: %(<i class="fa fa-check fa-fw" aria-hidden="true"></i> #{t('all.verb.destroy_selection')})
          ).merge(v2__table_selection_target: 'bulk')
        }
          %i.fa.fa-trash.fa-fw
          = t('all.verb.destroy_selection')
      .d-flex.gap-2.align-items-center
        = text_field_tag :deliverable_units_filter, nil, placeholder: t('all.verb.filter'), class: 'form-control form-control-sm', data: { v2__table_filter_target: 'input', action: 'input->v2--table-filter#filter' }
        %span
          %span{data: { v2__table_filter_target: 'count' }}= @deliverable_units.count
          = t 'activerecord.models.deliverable_units', count: @deliverable_units.count
  = form_tag deliverable_units_path, method: :delete, id: 'deliverable-units-destroy' do
    %table#deliverable-units.table.table-striped.table-hover.table-sm.deliverable-units-table.mb-0
      %thead
        %tr
          %th
            %input{type: 'checkbox', disabled: !can_destroy, data: { v2__table_selection_target: 'all', action: 'change->v2--table-selection#toggleAll' }, title: t('all.verb.toggle_selection')}
          %th= t 'activerecord.attributes.deliverable_unit.label'
          %th= t 'activerecord.attributes.deliverable_unit.ref'
          %th= t 'activerecord.attributes.deliverable_unit.icon'
          %th.du-col-sidebar-hide= t 'activerecord.attributes.deliverable_unit.default_pickup'
          %th.du-col-sidebar-hide= t 'activerecord.attributes.deliverable_unit.default_delivery'
          %th= t 'activerecord.attributes.deliverable_unit.default_capacity'
          %th.du-col-sidebar-hide= t 'activerecord.attributes.deliverable_unit.optimization_overload_multiplier'
          %th.deliverable-units-actions-col
      %tbody#deliverable-units-list
        - @deliverable_units.each do |deliverable_unit|
          = render 'v2/deliverable_units/list_row', deliverable_unit: deliverable_unit, can_destroy: can_destroy
