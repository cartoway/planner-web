-# Copyright © Cartoway
- icon_field = "#{model_class}_icon"
- size_field = "#{model_class}_icon_size"
- icon_value = @customer.public_send(icon_field)
- size_value = @customer.public_send(size_field)
.mb-3.row{id: "customer_#{model_class}_icon_input"}
  %label.col-form-label.col-md-10.offset-md-1.fw-bold{for: "customer_#{icon_field}"}
    = t("activerecord.attributes.customer.#{icon_field}")
  .col-md-10.offset-md-1.field
    .input-group
      = select_tag "customer[#{icon_field}]", grouped_options_for_select([[t("customers.form.map_markers.#{model_class}.prefered_icons"), grouped_icons[0].map { |icon| [icon, icon] }], [t("customers.form.map_markers.#{model_class}.other_icons"), grouped_icons[1].map { |icon| [icon, icon] }]], icon_value), include_blank: t('customers.form.value_default', n: default_icon), class: 'form-select', id: "customer_#{icon_field}", data: { controller: 'v2--tom-select', v2__tom_select_simple_value: true }
      = select_tag "customer[#{size_field}]", options_for_select([[t('tags.form.icon_size.small'), :small], [t('tags.form.icon_size.medium'), :medium], [t('tags.form.icon_size.large'), :large]], size_value), include_blank: t('customers.form.value_default', n: t("tags.form.icon_size.#{default_size}")), class: 'form-select', id: "customer_#{size_field}"
      %span.input-group-text
        %i.fa{class: "#{addon_icon} fa-fw"}
    %p.form-text= t("customers.form.#{model_class}_icon_help")
