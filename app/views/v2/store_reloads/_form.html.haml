-# V2 sidebar nested store reload (BS5). Do not use store_reloads/_form (BS3 collapse.in).
- srf = ->(key, **opts) { I18n.t(key, scope: 'store_reloads.form', **opts) }
- form_mutable = local_assigns.fetch(:form_mutable, true)
- v2_label_col = local_assigns.fetch(:v2_label_col, 'col-form-label col-md-10 offset-md-1 fw-bold')
- v2_bootstrap_label_col = local_assigns.fetch(:v2_bootstrap_label_col, 'col-md-10 offset-md-1 fw-bold')
- v2_control_col = local_assigns.fetch(:v2_control_col, 'col-md-10 offset-md-1 field')
= fields_for 'store[store_reloads_attributes]', store_reload, index: i, layout: :horizontal, builder: BootstrapForm::V2FormBuilder, label_col: v2_bootstrap_label_col, control_col: v2_control_col do |f|
  %fieldset.store-reload-fieldset
    %a{name: "store_reload_id=#{store_reload.id}"}
    %legend.scheduler-border
      %a.accordion-toggle.text-decoration-none{href: "#", role: "button", "data-bs-toggle": "collapse", "data-bs-target": "#collapseStoreReload#{store_reload.id || i}", "aria-expanded": "true"}
        %i.fa.fa-chevron-right.fa-fw.accordion-chevron{'aria-hidden': 'true'}
        %span.store-reload-legend{data: { index: i }}= srf.call('legend', n: i)
      - if form_mutable
        .destroy-block
          %button.btn.btn-outline-danger.btn-sm.text-nowrap{type: "button", title: srf.call('delete_help'), data: { action: 'click->v2--nested-fields#remove' }}
            %i.fa.fa-trash.fa-fw
            = srf.call('delete')
    .collapse.show{id: "collapseStoreReload#{store_reload.id || i}"}
      = f.hidden_field :id
      = hidden_field_tag "store[store_reloads_attributes][#{i}][_destroy]", '0', class: 'store-reload-destroy-flag'
      - if customer.enable_references
        = f.text_field :ref, help: srf.call('ref_help')
      = f.text_field :duration,
        value: store_reload.duration_time_with_seconds,
        placeholder: customer.store_reload_duration ? "#{customer.store_reload_duration_time_with_seconds} (#{srf.call('duration_default')})" : t('all.unit.hour_minute_second'),
        append: content_tag('i', '', class: 'fa fa-stopwatch fa-fw'),
        help: srf.call('duration_help')
      #store_reload_open_close_input.mb-3.row.fleet-split{class: "#{nested_has_error?(:time_window_end, store_reload.id)}"}
        %label.visually-hidden{for: "store_store_reloads_attributes_#{i}_time_window_start"}= t 'activerecord.attributes.store_reload.time_window_start'
        %label.visually-hidden{for: "store_store_reloads_attributes_#{i}_time_window_end"}= t 'activerecord.attributes.store_reload.time_window_end'
        %label{class: v2_label_col}= srf.call('time_window_start_end')
        %div{class: v2_control_col}
          .input-group.mb-2
            %span.input-group-text.fleet-bound-label= t 'web.form.from_time'
            = text_field "store[store_reloads_attributes][#{i}]", :time_window_start, class: 'form-control', placeholder: t('all.unit.hour_minute'), value: store_reload.time_window_start_time
            %span.input-group-text.input-group-borderless= t 'web.form.days'
            = number_field "store[store_reloads_attributes][#{i}]", :time_window_start_day,
              class: 'form-control number-of-days',
              placeholder: '0',
              min: 0,
              value: number_of_days(store_reload.time_window_start)
          .input-group
            %span.input-group-text.fleet-bound-label= t 'web.form.to_time'
            = text_field "store[store_reloads_attributes][#{i}]", :time_window_end, class: 'form-control', placeholder: t('all.unit.hour_minute'), value: store_reload.time_window_end_time
            %span.input-group-text.input-group-borderless= t 'web.form.days'
            = number_field "store[store_reloads_attributes][#{i}]", :time_window_end_day,
              class: 'form-control number-of-days',
              placeholder: '0',
              min: 0,
              value: number_of_days(store_reload.time_window_end)
            %span.input-group-text
              %i.fa.fa-arrows-left-right.fa-fw
          %p.help-block= srf.call('time_window_start_end_help')
