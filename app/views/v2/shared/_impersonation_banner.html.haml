- return unless workspace_impersonating?
.workspace-impersonation-banner.alert.alert-warning.mb-0.rounded-0.py-2{role: 'status'}
  .container-fluid.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
    %span
      = t('workspaces.impersonation.banner', name: workspace_chip_label)
    = button_to t('workspaces.chip.stop_impersonating'),
      switch_workspace_path(stop_impersonating: 1),
      method: :post,
      class: 'btn btn-sm btn-outline-dark',
      data: { turbo: false }
