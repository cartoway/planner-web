-# V2 destinations index list + pagination — wrapped for Turbo Frame partial updates (see destinations#index).
- can_destroy_destinations = current_user_form_destroy_enabled?(:destination)
- list_columns = @destinations_list_columns || destinations_list_active_column_ids(@customer)
- empty_colspan = 2 + list_columns.size
= turbo_frame_tag "destinations_list" do
  .d-flex.justify-content-between.align-items-center.mb-2.p-3
    .d-flex.gap-2.align-items-center
      = link_to new_destination_path, class: 'btn btn-primary btn-sm', data: { turbo_frame: "form_sidebar", turbo_prefetch: "false" } do
        %i.fa.fa-plus.fa-fw
        = t 'destinations.index.new'
      %button.btn.btn-danger.btn-sm.destinations-bulk-delete{type: "button", disabled: !can_destroy_destinations, title: t('all.verb.destroy_selection')}
        %i.fa.fa-trash.fa-fw
        = t('all.verb.destroy_selection')
      = render 'v2/destinations/list_column_selector'
    %span#count= "#{@destinations.size} / #{@total_count} #{t 'activerecord.models.destinations', count: @total_count}"
  #destination_box.destinations-list-scroll
    .table-responsive
      %table.table.table-striped.table-condensed
        %thead
          %tr
            %th.destinations-selection-col
              %button.btn.btn-light.btn-xs.destinations-toggle-selection{type: "button", title: t('all.verb.toggle_selection')}
                %i.fa.fa-check.fa-fw
            - list_columns.each do |column_id|
              %th= destinations_list_column_label(column_id)
            %th
        %tbody
          - if @destinations.any?
            - @destinations.each do |destination|
              %tr.destination{data: {destination_id: destination.id, lat: destination.lat, lng: destination.lng}}
                %td.destinations-selection-col
                  %input{type: "checkbox", id: "destination_#{destination.id}", name: "destinations[#{destination.id}]", value: "1"}
                - list_columns.each do |column_id|
                  = render 'v2/destinations/list_column_cell', destination: destination, column_id: column_id
                %td.text-nowrap
                  .btn-group.btn-group-sm{role: "group"}
                    = link_to edit_destination_path(destination), class: 'btn btn-light btn-xs', data: { turbo_frame: "form_sidebar", turbo_prefetch: "false" } do
                      %i.fa.fa-pencil.fa-fw
                    %button.btn.btn-danger.btn-xs.destinations-row-delete{type: "button", disabled: !can_destroy_destinations, title: t('all.verb.destroy'), data: { destination_id: destination.id }}
                      %i.fa.fa-trash.fa-fw
          - else
            %tr
              %td.text-center.text-muted{colspan: empty_colspan}
                = t 'api_web.v01.destinations.index.none_destinations', default: 'Aucune destination trouvée'

    - if @pagination[:per_page].positive? && @pagination[:total] > @pagination[:per_page]
      - total_pages = (@pagination[:total].to_f / @pagination[:per_page]).ceil
      - pagination_params = destinations_index_params
      %nav.text-center.mt-2
        %ul.pagination.pagination-sm.justify-content-center
          %li{class: ('disabled' if @pagination[:page] <= 1)}
            - if @pagination[:page] > 1
              = link_to destinations_path(pagination_params.merge(page: @pagination[:page] - 1)), class: 'btn btn-light btn-sm', data: { turbo_frame: 'destinations_list', turbo_action: 'advance' } do
                %i.fa.fa-chevron-left
            - else
              %span.btn.btn-light.btn-sm.disabled
                %i.fa.fa-chevron-left
          %li.disabled
            %span.btn.btn-light.btn-sm= "#{@pagination[:page]} / #{total_pages}"
          %li{class: ('disabled' if @pagination[:page] >= total_pages)}
            - if @pagination[:page] < total_pages
              = link_to destinations_path(pagination_params.merge(page: @pagination[:page] + 1)), class: 'btn btn-light btn-sm', data: { turbo_frame: 'destinations_list', turbo_action: 'advance' } do
                %i.fa.fa-chevron-right
            - else
              %span.btn.btn-light.btn-sm.disabled
                %i.fa.fa-chevron-right
