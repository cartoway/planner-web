-# V2 destinations index list + pagination — wrapped for Turbo Frame partial updates (see destinations#index).
-# Counts also live on an inner meta node: Turbo replaces frame *contents* only, not outer data-* attrs.
= turbo_frame_tag "destinations_list", data: { per_page: @pagination[:per_page], shown_count: @destinations.size, total_count: @total_count, controller: 'v2--table-selection v2--index-selection', v2__index_selection_select_label_value: t('all.verb.select'), v2__index_selection_cancel_label_value: t('all.verb.cancel') } do
  %span.d-none#destinations-list-counts{
    data: {
      destinations_list_counts: true,
      shown_count: @destinations.size,
      total_count: @total_count,
      count_label: t('activerecord.models.destinations', count: @total_count),
      page_visits_count: @page_visits_count,
      total_visits_count: @total_visits_count,
      visits_count_label: t('activerecord.models.visits', count: @total_visits_count)
    },
    "aria-hidden": "true"
  }
  .destinations-list-toolbar.d-flex.justify-content-between.align-items-center.mb-2.px-3.pt-3.pb-2.flex-wrap.gap-2
    .destinations-list-toolbar-actions.d-flex.gap-1.align-items-center.flex-wrap
      = link_to new_destination_path, class: 'btn btn-primary', title: t('destinations.index.new'), data: { turbo_frame: "form_sidebar", turbo_prefetch: "false" } do
        %i.fa.fa-plus.fa-fw
        %span.destinations-toolbar-label= t 'destinations.index.new'
      %button.btn.btn-outline-secondary{type: 'button', title: t('all.verb.select'), data: { action: 'v2--index-selection#toggle' }}
        %i.fa.fa-check-square.fa-fw{"aria-hidden": "true"}
        %span.destinations-toolbar-label{data: { v2__index_selection_target: 'toggleLabel' }}= t('all.verb.select')
      %button.btn.btn-danger.destinations-bulk-delete{
        type: "button",
        disabled: true,
        title: t('all.verb.destroy_selection'),
        data: confirm_click_data(
          group: 'destinations-destroy',
          wait_message: t('all.verb.destroy_confirm_wait'),
          confirm_message: t('all.verb.destroy_confirm'),
          base_class: 'btn-danger'
        ).merge(v2__table_selection_target: 'bulk')
      }
        %i.fa.fa-trash.fa-fw
        %span.destinations-toolbar-label= t('all.verb.destroy_selection')
    .destinations-list-toolbar-meta.d-flex.gap-1.align-items-center.flex-wrap.ms-auto
      = render 'v2/destinations/list_sort_selector'
      .dropdown
        %button.btn.btn-light.dropdown-toggle{type: 'button', data: { 'bs-toggle': 'dropdown' }, 'aria-expanded': 'false', title: t('all.misc.per_page')}
          %i.fa.fa-list-ol.fa-fw
          %span.destinations-toolbar-label= "#{@pagination[:per_page]} #{t('all.misc.per_page')}"
        %ul.dropdown-menu.dropdown-menu-end
          - destinations_index_per_page_options.each do |option|
            %li
              = link_to destinations_path(destinations_index_params(page: 1, per_page: option)),
                class: "dropdown-item destinations-per-page-option#{' active' if @pagination[:per_page] == option}",
                data: { turbo_frame: 'destinations_list', turbo_action: 'advance', per_page: option } do
                = "#{option} #{t('all.misc.per_page')}"
      = render 'v2/destinations/list_column_selector'
  = render 'v2/destinations/list_body'
