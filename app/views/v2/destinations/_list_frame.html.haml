-# V2 destinations index list + pagination — wrapped for Turbo Frame partial updates (see destinations#index).
= turbo_frame_tag "destinations_list" do
  .d-flex.justify-content-between.align-items-center.mb-2.p-3
    = link_to new_destination_path, class: 'btn btn-primary btn-sm', data: { turbo_frame: "form_sidebar", turbo_prefetch: "false" } do
      %i.fa.fa-plus.fa-fw
      = t 'destinations.index.new'
    %span#count= "#{@destinations.size} / #{@total_count} #{t 'activerecord.models.destinations', count: @total_count}"
  %button.btn.btn-default.btn-sm.destinations-sidebar-toggle{type: "button", title: t('destinations.index.collapse_list', default: 'Réduire la liste')}
    %i.fa.fa-chevron-left
  .destinations-sidebar-expand.d-none
    %button.btn.btn-default.btn-sm{type: "button", title: t('destinations.index.expand_list', default: 'Afficher la liste')}
      %i.fa.fa-chevron-right
  #destination_box.destinations-list-scroll
    .table-responsive
      %table.table.table-striped.table-condensed
        %thead
          %tr
            %th= t 'activerecord.attributes.destination.name'
            %th= t 'activerecord.attributes.destination.address'
            - if @customer.enable_references
              %th= t 'activerecord.attributes.destination.ref_small'
            %th= t 'activerecord.attributes.destination.geocoding_accuracy_small'
            %th= t 'activerecord.models.visit'
            %th
        %tbody
          - if @destinations.any?
            - @destinations.each do |destination|
              %tr.destination{data: {destination_id: destination.id, lat: destination.lat, lng: destination.lng}}
                %td= destination.name
                %td= [destination.street, destination.postalcode, destination.city, destination.country].compact.join(' ')
                - if @customer.enable_references
                  %td= destination.ref
                %td
                  - if destination.geocoding_accuracy
                    = number_to_percentage(destination.geocoding_accuracy * 100, precision: 0)
                  - else
                    –
                %td= "#{destination.visits.count} #{t 'activerecord.models.visits', count: destination.visits.count}"
                %td
                  = link_to edit_destination_path(destination), class: 'btn btn-default btn-xs', data: { turbo_frame: "form_sidebar", turbo_prefetch: "false" } do
                    %i.fa.fa-pencil
          - else
            %tr
              %td.text-center.text-muted{colspan: (@customer.enable_references ? 6 : 5)}
                = t 'api_web.v01.destinations.index.none_destinations', default: 'Aucune destination trouvée'

    - if @pagination[:per_page].positive? && @pagination[:total] > @pagination[:per_page]
      - total_pages = (@pagination[:total].to_f / @pagination[:per_page]).ceil
      - pagination_params = destinations_index_params
      %nav.text-center.mt-2
        %ul.pagination.pagination-sm.justify-content-center
          %li{class: ('disabled' if @pagination[:page] <= 1)}
            - if @pagination[:page] > 1
              = link_to destinations_path(pagination_params.merge(page: @pagination[:page] - 1)), class: 'btn btn-default btn-sm', data: { turbo_frame: 'destinations_list', turbo_action: 'advance' } do
                %i.fa.fa-chevron-left
            - else
              %span.btn.btn-default.btn-sm.disabled
                %i.fa.fa-chevron-left
          %li.disabled
            %span.btn.btn-default.btn-sm= "#{@pagination[:page]} / #{total_pages}"
          %li{class: ('disabled' if @pagination[:page] >= total_pages)}
            - if @pagination[:page] < total_pages
              = link_to destinations_path(pagination_params.merge(page: @pagination[:page] + 1)), class: 'btn btn-default btn-sm', data: { turbo_frame: 'destinations_list', turbo_action: 'advance' } do
                %i.fa.fa-chevron-right
            - else
              %span.btn.btn-default.btn-sm.disabled
                %i.fa.fa-chevron-right
