-# V2 destinations index list + pagination — wrapped for Turbo Frame partial updates (see destinations#index).
= turbo_frame_tag "destinations_list" do
  .d-flex.justify-content-between.align-items-center.mb-2.p-3
    .d-flex.gap-2.align-items-center
      = link_to new_destination_path, class: 'btn btn-primary btn-xs', data: { turbo_frame: "form_sidebar", turbo_prefetch: "false" } do
        %i.fa.fa-plus.fa-fw
        = t 'destinations.index.new'
      %button.btn.btn-danger.btn-xs.destinations-bulk-delete{
        type: "button",
        disabled: !current_user_form_destroy_enabled?(:destination),
        title: t('all.verb.destroy_selection'),
        data: confirm_click_data(
          group: 'destinations-destroy',
          wait_message: t('all.verb.destroy_confirm_wait'),
          confirm_message: t('all.verb.destroy_confirm'),
          ready_label: %(<i class="fa fa-check fa-fw" aria-hidden="true"></i> #{t('all.verb.destroy_selection')}),
          base_class: 'btn-danger'
        )
      }
        %i.fa.fa-trash.fa-fw
        = t('all.verb.destroy_selection')
      = render 'v2/destinations/list_column_selector'
      .dropdown
        %button.btn.btn-light.btn-xs.dropdown-toggle{type: 'button', data: { 'bs-toggle': 'dropdown' }, 'aria-expanded': 'false'}
          %i.fa.fa-list-ol.fa-fw
          = "#{@pagination[:per_page]} #{t('all.per_page', default: 'par page')}"
        %ul.dropdown-menu
          - destinations_index_per_page_options.each do |option|
            %li
              = link_to destinations_path(destinations_index_params(page: 1, per_page: option)),
                class: "dropdown-item#{' active' if @pagination[:per_page] == option}" do
                = "#{option} #{t('all.per_page', default: 'par page')}"
    #count.primary.data-info{title: t('destinations.index.destinations_count_help')}
      %i.fa.fa-check-square.fa-fw{"aria-hidden": "true"}
      = "#{@destinations.size} / #{@total_count}"
      = t('activerecord.models.destinations', count: @total_count)
  = render 'v2/destinations/list_body'
