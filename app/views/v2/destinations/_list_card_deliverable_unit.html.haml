-# locals: du_data — { unit:, pickup:, delivery: }
-# Renders nothing when both quantities are zero (dense cards omit empty fields).
- unit = du_data[:unit]
- pickup = du_data[:pickup]
- delivery = du_data[:delivery]
- unless pickup.zero? && delivery.zero?
  %span.destinations-list-deliverable-unit-qty
    %i.fa{class: unit.default_icon, 'aria-hidden': 'true'}
    - if pickup.positive?
      %i.fa.fa-up-long.fa-fw{'aria-hidden': 'true', title: t('destinations.index.pickup')}
      = number_with_precision(pickup, precision: 2, delimiter: t('number.format.delimiter'), strip_insignificant_zeros: true)
    - if delivery.positive?
      %i.fa.fa-down-long.fa-fw{'aria-hidden': 'true', title: t('destinations.index.delivery')}
      = number_with_precision(delivery, precision: 2, delimiter: t('number.format.delimiter'), strip_insignificant_zeros: true)
    - if unit.label.present?
      %span.destinations-list-deliverable-unit-label= unit.label
