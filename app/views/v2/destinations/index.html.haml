-# Copyright © Cartoway
-# V2 destinations index - map as background, collapsible list overlay on the left
- content_for :form_sidebar do
  = render "v2/layouts/form_sidebar_placeholder"
- content_for :title, t('destinations.index.title')
-# MapLibre loads tiles via fetch; always use HTTPS tile URLs (HTTP OSM tiles 301 without CORS).
-# Prefer vector_style_url when present; raster url remains the fallback.
- layers = (@customer.profile.layers + [current_user.layer]).sort_by(&:id).uniq.collect{ |layer| { name: layer.translated_name, url: layer.url, vector_style_url: layer.vector_style_url, attribution: layer.map_attribution, default: layer == current_user.layer, overlay: layer.overlay } }
- v2_js_cfg = { map_lat: @customer.default_position[:lat], map_lng: @customer.default_position[:lng], map_zoom: 12, geocoder: true }
- v2_js_cfg[:geocoder_placeholder] = t('web.geocoder.search')
- v2_js_cfg[:geocoder_empty] = t('web.geocoder.empty_result')
- v2_js_cfg[:geocoder_tooltip] = t('web.geocoder.tooltip')
- v2_js_cfg[:geocoder_submit] = t('web.geocoder.submit_search')
- v2_js_cfg[:map_layers_title] = t('destinations.index.map_layers')
- v2_js_cfg[:map_base_layers_title] = t('destinations.index.map_base_layers')
- v2_js_cfg[:map_overlay_title] = t('destinations.index.map_overlay_layers')
- v2_js_cfg[:map_layers] = Hash[layers.map{ |l| l[:name] }.zip(layers)]
- v2_js_cfg[:map_geojson_url] = map_destinations_path
- v2_js_cfg[:can_destroy] = current_user_form_destroy_enabled?(:destination)
- v2_js_cfg[:form_sidebar_placeholder] = t('v2.layout.form_sidebar_placeholder')
- v2_js_cfg[:highlight_destination_id] = params[:highlight_destination_id].to_i if params[:highlight_destination_id].present?
- v2_js_config = v2_js_cfg.to_json
#destinations-map-layout{data: { controller: 'v2--destinations-index', config: v2_js_config }}
  #map.destinations-map.maplibre-host

  .destinations-sidebar.slide-panel.slide-panel--from-left
    .destinations-sidebar-header
      %button.floating-btn.destinations-sidebar-toggle{type: "button", title: t('destinations.index.collapse_list', default: 'Réduire la liste'), 'aria-label': t('destinations.index.collapse_list', default: 'Réduire la liste')}
        %i.fa.fa-chevron-left.fa-fw{"aria-hidden": "true"}
      %h1.mb-2= t 'destinations.index.title'
      - if current_user.customer.too_many_destinations?
        .alert.alert-warning{data: {error: "true"}}
          %p= t 'destinations.index.over_max_limit', limit: current_user.customer.default_max_destinations
      = form_tag destinations_path, method: :get, id: 'destinations-search-form', class: 'form-group' do
        %input{type: "hidden", name: "per_page", value: @pagination[:per_page]}
        - if params[:sort].present?
          %input{type: "hidden", name: "sort", value: params[:sort]}
        - if params[:direction].present?
          %input{type: "hidden", name: "direction", value: params[:direction]}
        - Array(@active_filters).each do |filter|
          %input{type: "hidden", name: "filters[]", value: filter}
        = render 'v2/destinations/filtered_search_field', input_id: 'search-query', input_value: @search_query, active_filters: Array(@active_filters), debounce: true
        %small.help-block= t('destinations.index.search_help')
    = render 'v2/destinations/list_frame'
  %button.floating-btn.destinations-sidebar-expand.slide-panel-expand-trigger{type: "button", title: t('destinations.index.expand_list', default: 'Afficher la liste'), 'aria-label': t('destinations.index.expand_list', default: 'Afficher la liste')}
    %i.fa.fa-chevron-right.fa-fw{"aria-hidden": "true"}
  %button.floating-btn.xl-floating-button.destinations-position-drag-cancel.d-none{type: "button", title: t('destinations.index.cancel_position_drag'), 'aria-label': t('destinations.index.cancel_position_drag')}
    %i.fa.fa-times{"aria-hidden": "true"}
    %span.floating-label= t('destinations.index.cancel_position_drag')
