-# Copyright © Cartoway
-# V2 destinations index - map as background, collapsible list overlay on the left
- content_for :form_sidebar do
  = render "v2/layouts/form_sidebar_placeholder"
- content_for :title, t('destinations.index.title')
- layers = (@customer.profile.layers + [current_user.layer]).sort_by(&:id).uniq.collect{ |layer| { name: layer.translated_name, url: request.ssl? ? layer.urlssl : layer.url, attribution: layer.map_attribution, default: layer == current_user.layer, overlay: layer.overlay } }
- v2_js_cfg = { map_lat: @customer.default_position[:lat], map_lng: @customer.default_position[:lng], map_zoom: 12, geocoder: true, map_overlay_title: t('destinations.index.map_overlay_layers'), map_layers: Hash[layers.map{ |l| l[:name] }.zip(layers)], destinations: @v2_map_destinations }
- v2_js_cfg[:highlight_destination_id] = params[:highlight_destination_id].to_i if params[:highlight_destination_id].present?
- v2_js_config = v2_js_cfg.to_json
#destinations-map-layout{data: { controller: 'v2--destinations-index', config: v2_js_config }}
  #map.destinations-map

  .destinations-sidebar
    .destinations-sidebar-header
      %h1.mb-2= t 'destinations.index.title'
      - if current_user.customer.too_many_destinations?
        .alert.alert-warning{data: {error: "true"}}
          %p= t 'destinations.index.over_max_limit', limit: current_user.customer.default_max_destinations
      = form_tag destinations_path, method: :get, id: 'destinations-search-form', class: 'form-group' do
        %input{type: "hidden", name: "per_page", value: @pagination[:per_page]}
        - Array(@active_filters).each do |filter|
          %input{type: "hidden", name: "filters[]", value: filter}
        .destinations-search-wrapper
          %input.form-control#search-query{type: "text", name: "q", placeholder: destinations_search_placeholder, value: @search_query, autocomplete: "off", data: {min_chars: 3, debounce_ms: 300}}
          #search-filters-badges.mt-1
            - if @active_filters.present?
              - @active_filters.each do |filter|
                %span.badge.bg-primary.me-1.mb-1.search-filter-badge{data: {filter: filter}}
                  = filter
                  %a.ms-1.text-white{href: destinations_path(destinations_index_params_without_filter(filter)), title: t('destinations.index.remove_filter')}
                    %i.fa.fa-times
        %small.help-block= t 'destinations.index.search_help', default: 'Syntax: field:value (e.g. name:Paris, city:Lyon)'
    = render 'v2/destinations/list_frame'
