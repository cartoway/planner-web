-# V2 sidebar-only: same fields as destinations/_form; relative i18n keys resolved via destinations.form scope
- df = ->(key, **opts) { I18n.t(key, scope: 'destinations.form', **opts) }
- dest_form_mutable = current_user_destination_form_submit_enabled?(@destination)
-# Sidebar submit targets _top so successful save returns to the v2 index; Turbo pushes 422 responses back into form_sidebar.
- form_html = { class: "form-horizontal", "data-destination_id" => (@destination.id or 0), id: "destination-form-sidebar", "data-turbo-frame" => "_top", "data-position-editable" => (dest_form_mutable ? "true" : "false"), "data-tag-entity-create-allowed" => (current_user_form_create?(:tags) ? "true" : "false") }
- form_html["data-v2--dirty-form-submit-target"] = "form" if dest_form_mutable
- v2_label_col = 'col-form-label col-md-10 offset-md-1 fw-bold'
- v2_bootstrap_label_col = 'col-md-10 offset-md-1 fw-bold'
- v2_control_col = 'col-md-10 offset-md-1 field'
- visits_list_data = { controller: 'v2--visit-collapses v2--visit-list' }
- if defined?(@scroll_to_visit_id) && @scroll_to_visit_id.present?
  - visits_list_data[:v2__visit_list_scroll_to_visit_id_value] = @scroll_to_visit_id
- geocoding_level_labels = Destination.geocoding_levels.keys.index_with { |level| t("destinations.form.geocoding_level.#{level}") }
- destination_details_data = {}
- if dest_form_mutable
  - destination_details_data[:controller] = 'v2--destination-geocoding'
  - destination_details_data[:v2__destination_geocoding_confirm_overwrite_point_value] = t('destinations.form.dialog.confirm_overwrite_point')
  - destination_details_data[:v2__destination_geocoding_geocode_in_progress_value] = df.call('geocode_in_progress')
  - destination_details_data[:v2__destination_geocoding_accuracy_success_value] = Planner::Application.config.geocoder.accuracy_success
  - destination_details_data[:v2__destination_geocoding_accuracy_warning_value] = Planner::Application.config.geocoder.accuracy_warning
  - destination_details_data[:v2__destination_geocoding_geocoding_level_labels_value] = geocoding_level_labels.to_json
= bootstrap_form_for(@destination, layout: :horizontal, builder: BootstrapForm::V2FormBuilder, label_col: v2_bootstrap_label_col, control_col: v2_control_col, html: form_html) do |f|
  = hidden_field_tag :v2_sidebar, '1'
  = render 'shared/error_messages', model: @destination
  %fieldset#destination-details{ data: destination_details_data }
    - if @destination.customer.enable_references
      = f.text_field :ref, help: df.call('ref_help')
    = hidden_field_tag "destination[geocoding_result]", @destination.geocoding_result.to_json
    - if dest_form_mutable
      = hidden_field_tag "destination[geocode_on_save]", ""
      = hidden_field_tag "destination[geocode_on_save_fingerprint]", ""
    = f.text_field :name, required: true
    = f.text_field :street, help: t('web.form.helpers.street')
    = f.text_field :detail, help: df.call('detail_help')
    #destination_city_input.mb-3.row
      %label.sr-only{for: "destination_postalcode"}= t 'activerecord.attributes.destination.postalcode'
      %label.sr-only{for: "destination_city"}= t 'activerecord.attributes.destination.city'
      %label{class: v2_label_col}
        = t 'activerecord.attributes.destination.postalcode'
        \/ #{t 'activerecord.attributes.destination.city'}
      %div{class: v2_control_col}
        .input-group
          = text_field :destination, :postalcode, maxlength: 17, class: 'form-control'
          = text_field :destination, :city, class: 'form-control'
          %span.input-group-text
            %i.fa.fa-map.fa-fw
    - if !@destination.customer.with_state
      #destination_country_input.mb-3.row
        %label{class: v2_label_col}
          = "#{t('activerecord.attributes.destination.state')}/#{t('activerecord.attributes.destination.country')}"
        %div{class: v2_control_col}
          .input-group
            = text_field :destination, :state, class: 'form-control'
            = text_field :destination, :country, placeholder: t('web.form.default_short', n: @destination.customer.default_country), class: 'form-control'
            %span.input-group-text
              %i.fa.fa-map.fa-fw
    - else
      = f.text_field :country, {placeholder: t('web.form.default_short', n: @destination.customer.default_country)}
    .mb-3.row
      %label{class: v2_label_col, for: "destination_geocoding"}= t 'activerecord.attributes.destination.geocoding_accuracy'
      %div{class: v2_control_col}
        - if dest_form_mutable
          #destination-geocode-prompt.mb-2{ class: ('d-none' unless destination_form_address_geocodable?(@destination)), data: { v2__destination_geocoding_target: 'prompt' } }
            %button.btn.btn-light.btn-xs.w-100{type: 'button', data: { v2__destination_geocoding_target: 'geocodeButton', action: 'click->v2--destination-geocoding#geocode' }}
              %i.fa.fa-map-marker.fa-fw{"aria-hidden": "true"}
              %span{ data: { v2__destination_geocoding_target: 'geocodeButtonLabel' } }= df.call('geocode_prompt')
        #geocoding_accuracy{ class: ('d-none' unless @destination.geocoding_accuracy) }
          #geocoding-progress.progress
            %input{name: "destination[geocoding_accuracy]", type: "hidden", value: @destination.geocoding_accuracy}
            .progress-bar{ class: "progress-bar-#{@destination.geocode_progress_bar_class}", style: "width: #{((@destination.geocoding_accuracy || 0) * 100).round}%"}
              %span= @destination.geocoding_accuracy ? ((@destination.geocoding_accuracy || 0) * 100).round.to_s + '%' : ''
          %p.help-block= df.call('geocoding_accuracy_help')
          #geocoding_fail.d-none
            = df.call('geocoding_fail')
            \-
            %span.text-muted.small
              %i.fa.fa-map-marker.fa-fw
              = df.call('v2_list_map_position_help')
        #no_geocoding_accuracy{ class: ('d-none' if @destination.geocoding_accuracy)}
          = df.call('geocoding_accuracy_none')
        #geocoding_level{ class: ('d-none' unless @destination.geocoding_level)}
          %input{name: "destination[geocoding_level]", type: "hidden", value: @destination.geocoding_level}
          %i.fa.fa-map-marker.fa-fw.geocoding-level{ class: ('d-none' unless @destination.point?), data: { geocoding_level: 'point' } }
          %i.fa.fa-store.fa-fw.geocoding-level{ class: ('d-none' unless @destination.house?), data: { geocoding_level: 'house' } }
          %i.fa.fa-intersection.fa-fw.geocoding-level{ class: ('d-none' unless @destination.intersection?), data: { geocoding_level: 'intersection' } }
          %i.fa.fa-street.fa-fw.geocoding-level{ class: ('d-none' unless @destination.street?), data: { geocoding_level: 'street' } }
          %i.fa.fa-city.fa-fw.geocoding-level{ class: ('d-none' unless @destination.city?), data: { geocoding_level: 'city' } }
          %span
            = t 'activerecord.attributes.destination.geocoding_level'
            \:
            %span#geocoding-level-value
              - if @destination.geocoding_level
                = t("destinations.form.geocoding_level.#{@destination.geocoding_level}")
      #geocoding_result_free.row{ class: ('d-none' if @destination.geocoding_result.empty?), data: { v2__destination_geocoding_target: 'geocodingResultRow' } }
        %label{class: v2_label_col, for: 'displayed-geocoding-result'}= t 'activerecord.attributes.destination.geocoding_result'
        %div{class: v2_control_col}
          %input.form-control#displayed-geocoding-result{type: 'text', value: destinations_list_geocoding_result_free(@destination), disabled: true, tabindex: -1, aria: { readonly: true }, data: { displayed_geocoding_result: true }}
      %div{class: v2_control_col}
        #destination-geocode-apply.d-none{ data: { v2__destination_geocoding_target: 'geocodeApplyPanel' } }
          %button.btn.btn-light.btn-xs.w-100{type: 'button', data: { v2__destination_geocoding_target: 'geocodeApplyButton', action: 'click->v2--destination-geocoding#applyGeocodedAddress' }}
            %i.fa.fa-check.fa-fw{"aria-hidden": "true"}
            = t('destinations.reverse_geocoding.apply')
        #reverse-geocode
    .row
      %div{class: v2_control_col}
        .alert.alert-info.small.v2-destination-map-position-hint.mb-0{role: "status"}
          %i.fa.fa-map.fa-fw
          = df.call('v2_list_map_position_help')
    #destination_geoloc_input.mb-3.row
      %label.sr-only{for: "destination_lat"}= t 'activerecord.attributes.destination.lat'
      %label.sr-only{for: "destination_lnt"}= t 'activerecord.attributes.destination.lng'
      %label{class: v2_label_col}
        = t 'activerecord.attributes.destination.lat'
        \/ #{t 'activerecord.attributes.destination.lng'}
      %div{class: v2_control_col}
        .input-group
          = number_field :destination, :lat, step: 0.000001, class: 'form-control'
          = number_field :destination, :lng, step: 0.000001, class: 'form-control'
          - show_map_drag_toggle = dest_form_mutable && @destination.persisted? && @destination.lat.present? && @destination.lng.present?
          %span.input-group-text.p-0.d-flex.btn-container
            - if show_map_drag_toggle
              - drag_idle = df.call('v2_map_position_drag_enable')
              - drag_active = df.call('v2_map_position_drag_disable')
              %button.btn.btn-light.border-0.rounded-0.h-100{type: 'button', title: drag_idle, data: { v2_map_position_drag_toggle: true, title_idle: drag_idle, title_active: drag_active }, 'aria-pressed': 'false'}
                %i.fa.fa-location-crosshairs.fa-fw{"aria-hidden": "true"}
            - else
              .d-flex.align-items-center.px-2
                %i.fa.fa-globe.fa-fw
    - tom_select_data = { controller: 'v2--tom-select', v2__tom_select_create_value: current_user_form_create?(:tags), v2__tom_select_placeholder_value: t('web.select2.placeholder') }
    .destination_visits_attributes_tag_ids_input
      = f.select :tag_ids, options_for_select(@destination.customer.tags.map { |tag| [tag.label, tag.id, tag_select_option_attributes(tag)] }, @destination.tags.collect(&:id)), {label: t('activerecord.attributes.destination.tag_ids'), help: df.call('tags_help'), append: content_tag('i', '', class: 'fa fa-tags fa-fw')}, {multiple: true, data: tom_select_data}
    = f.text_field :phone_number, {input_group: content_tag('i', '', class: 'fa fa-phone fa-fw')}
    = f.text_area :comment, help: df.call('comment_help')
    = f.text_field :duration,
      value: @destination.duration_time_with_seconds,
      placeholder: @destination.customer.destination_duration ? "#{@destination.customer.destination_duration_time_with_seconds} (#{df.call('duration_default')})" : t('all.unit.hour_minute_second'),
      append: content_tag('i', '', class: 'fa fa-map-marker fa-fw'),
      help: df.call('duration_help')
  - if @destination.persisted?
    .destination-visits{data: {controller: 'v2--visit-new'}}
      %template#visits-header-template{data: {v2__visit_new_target: 'headerTemplate'}}
        = render 'v2/destinations/visits_header'
      #visits{data: visits_list_data}
        - if @destination.visits.size > 1
          = render 'v2/destinations/visits_header'
        - @destination.visits.each_with_index do |visit, i|
          = render 'v2/visits/form', visit: visit, i: i+1, destination_form_mutable: dest_form_mutable, v2_label_col: v2_label_col, v2_bootstrap_label_col: v2_bootstrap_label_col, v2_control_col: v2_control_col
      - if dest_form_mutable
        %button#visit-new.btn.btn-light.btn-sm{type: 'button', role: 'button', title: t('destinations.form.visit.new_help'), data: {action: 'click->v2--visit-new#add'}}
          %i.fa.fa-plus.fa-fw
          = t('destinations.form.visit.new')
      - else
        %button#visit-new.btn.btn-light.btn-sm{title: t('destinations.form.visit.new_help'), type: 'button', disabled: true}
          %i.fa.fa-plus.fa-fw
          = t('destinations.form.visit.new')
      %template#visit-fieldset-template{data: {v2__visit_new_target: 'template'}}
        = render 'v2/visits/form', visit: @destination.visits.build, i: 0, destination_form_mutable: dest_form_mutable, v2_label_col: v2_label_col, v2_bootstrap_label_col: v2_bootstrap_label_col, v2_control_col: v2_control_col
  - else
    %button#visit-new.btn.btn-light.btn-sm{title: t('destinations.form.visit.new_help'), type: 'button', disabled: true}
      %i.fa.fa-plus.fa-fw
      = t('destinations.form.visit.new')
  = hidden_field :destination, :geocoder_version, :value => @destination.geocoder_version
  = hidden_field :destination, :geocoded_at, :value => @destination.geocoded_at
#visits-attributes-change-bulk-modal.modal.fade{role: "dialog", tabindex: "-1", "aria-labelledby": "visits-attributes-change-bulk-modal-title"}
  .modal-dialog
    .modal-content
      .modal-header
        %h4.modal-title#visits-attributes-change-bulk-modal-title= t 'destinations.form.dialog.attributes_change_bulk.title'
        %button.btn-close{type: "button", "data-bs-dismiss": "modal", "aria-label": t('web.dialog.close')}
      .modal-body
        .container-fluid
          .row
            .col-md-2
              %label= t 'activerecord.attributes.visit.tags'
            .col-md-10
              .form-inline
                Remplacer
                \#{select_tag 'from_visit_tags', options_for_select(@destination.customer.tags.map { |tag| [tag.label, tag.id, tag_select_option_attributes(tag)] }), {multiple: true, include_blank: true, class: 'form-control visit-tags-change-bulk', data: { controller: 'v2--tom-select', v2__tom_select_create_value: false, v2__tom_select_placeholder_value: t('web.select2.placeholder') }}}
                par
                \#{select_tag 'to_visit_tags', options_for_select(@destination.customer.tags.map { |tag| [tag.label, tag.id, tag_select_option_attributes(tag)] }), {multiple: true, include_blank: true, class: 'form-control visit-tags-change-bulk', data: { controller: 'v2--tom-select', v2__tom_select_create_value: false, v2__tom_select_placeholder_value: t('web.select2.placeholder') }}}
              %p.help-block
                = t('destinations.form.dialog.attributes_change_bulk.tags_help')
      .modal-footer
        %button.btn.btn-light{type: "button", "data-bs-dismiss": "modal"}
          %i.fa.fa-undo.fa-fw
          = t 'all.verb.cancel'
        %button.btn.btn-primary{type: "button", "data-bs-dismiss": "modal", name: "visits-attributes-change-bulk-apply", disabled: !dest_form_mutable}
          %i.fa.fa-list.fa-fw
          = t 'all.verb.apply'
