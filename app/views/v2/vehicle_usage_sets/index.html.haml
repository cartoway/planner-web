-# Copyright © Cartoway
- content_for :form_sidebar do
  = render "v2/layouts/form_sidebar_placeholder"
- content_for :title, t('vehicle_usage_sets.index.title')
- invisible_class = current_user.customer.vehicle_usage_sets.size > 1 ? '' : 'invisible'
- can_destroy_vehicle_config = current_user_form_destroy_enabled?(:vehicle_usages)
- can_update_vehicle_usage = current_user_form_update?(:vehicle_usages)
- can_create_vehicle_usage = current_user_form_create?(:vehicle_usages)
- can_view_vehicle_usage = current_user_form_visible?(:vehicle_usages)
- show_set_checkbox = current_user.customer.default_max_vehicle_usage_sets > 1
- sets_count = @vehicle_usage_sets.count
- vehicles_count = @vehicle_usage_sets[0]&.vehicle_usages&.count || 0
.vehicle-usage-sets-index{data: { controller: 'v2--vehicle-usage-sets-index v2--table-selection v2--index-selection', v2__index_selection_select_label_value: t('all.verb.select'), v2__index_selection_cancel_label_value: t('all.verb.cancel') }}
  .vehicle-usage-sets-toolbar.px-3.pt-3
    - if current_user.customer.too_many_vehicle_usage_sets? && current_user.customer.vehicle_usage_sets.size > 1
      .alert.alert-warning{data: { error: 'true' }}
        %p.mb-0= t 'vehicle_usage_sets.index.over_max_limit', limit: current_user.customer.default_max_vehicle_usage_sets
    .d-flex.justify-content-between.align-items-center.mb-3.flex-wrap.gap-2
      .d-flex.gap-2.align-items-center.flex-wrap
        - if show_set_checkbox
          - if current_user.customer.too_many_vehicle_usage_sets?
            %button.btn.btn-primary{
              type: 'button',
              disabled: !can_create_vehicle_usage,
              data: {
                controller: 'v2--toast',
                action: 'click->v2--toast#notify',
                v2__toast_message_param: t('vehicle_usage_sets.index.over_max_limit', limit: current_user.customer.default_max_vehicle_usage_sets),
                v2__toast_class_name_param: 'alert-warning'
              }
            }
              %i.fa.fa-plus.fa-fw
              = t 'vehicle_usage_sets.index.new'
          - else
            = link_to new_vehicle_usage_set_path, class: 'btn btn-primary', disabled: !can_create_vehicle_usage, data: { turbo_frame: 'form_sidebar', turbo_prefetch: 'false' } do
              %i.fa.fa-plus.fa-fw
              = t 'vehicle_usage_sets.index.new'
          %button.btn.btn-outline-secondary{type: 'button', class: invisible_class, title: t('all.verb.select'), data: { action: 'v2--index-selection#toggle' }}
            %i.fa.fa-check-square.fa-fw{"aria-hidden": "true"}
            %span{data: { v2__index_selection_target: 'toggleLabel' }}= t('all.verb.select')
          %button{
            type: 'button',
            class: "btn btn-danger #{invisible_class}",
            disabled: true,
            title: t('all.verb.destroy_selection'),
            data: confirm_click_destroy_data(
              group: 'vehicle-usage-sets-destroy',
              form: 'vehicle-usage-sets-destroy',
              ready_label: %(<i class="fa fa-check fa-fw" aria-hidden="true"></i> #{t('all.verb.destroy_selection')})
            ).merge(v2__table_selection_target: 'bulk')
          }
            %i.fa.fa-trash.fa-fw
            = t('all.verb.destroy_selection')
      = render 'v2/vehicle_usage_sets/counts', sets_count: sets_count, vehicles_count: vehicles_count
  = form_tag vehicle_usage_sets_path, method: :delete, id: 'vehicle-usage-sets-destroy' do
    #accordion-vehicle-usage-sets.v2-index-cards.vehicle-usage-sets-cards.px-3.pb-3{data: { v2__index_selection_target: 'root' }}
      - if show_set_checkbox
        .v2-index-cards-select-bar
          %label.mb-0.d-flex.align-items-center.gap-2
            %input{type: 'checkbox', class: invisible_class, disabled: !can_destroy_vehicle_config, title: t('all.verb.toggle_selection'), data: { v2__table_selection_target: 'all', action: 'change->v2--table-selection#toggleAll' }}
            %span= t('all.verb.select_all')
      - @vehicle_usage_sets.each_with_index do |vehicle_usage_set, i|
        - expanded = @expanded_vehicle_usage_set_id ? vehicle_usage_set.id == @expanded_vehicle_usage_set_id : i.zero?
        = render 'v2/vehicle_usage_sets/set_block', vehicle_usage_set: vehicle_usage_set, index: i, expanded: expanded, show_set_checkbox: show_set_checkbox, invisible_class: invisible_class, can_destroy_vehicle_config: can_destroy_vehicle_config, can_update_vehicle_usage: can_update_vehicle_usage, can_view_vehicle_usage: can_view_vehicle_usage, sets_count: sets_count
