-# Copyright © Cartoway
- content_for :title, t('plannings.index.title')
- settings = (current_user.export_settings || {}).stringify_keys
- export_stops = settings.key?('stops') ? Array(settings['stops']) : %w[out-of-route store rest inactive]
- show_mutate = current_user_space_action_visible?(:plannings, :edit)
- can_mutate = current_user_space_action_usable?(:plannings, :edit)
- can_destroy = can_mutate
- cannot_new = current_user.customer.too_many_plannings? || !can_mutate
- callback_visible = toolbar_operation_visible?(:planning, 'external_callback')
- callback_usable = toolbar_operation_usable?(:planning, 'external_callback')
- dashboard_visible = toolbar_operation_visible?(:planning, 'planning_dashboard')
- dashboard_usable = toolbar_operation_usable?(:planning, 'planning_dashboard')
.plannings-index{data: { controller: 'v2--table-filter v2--table-selection v2--index-selection v2--plannings-index', v2__index_selection_select_label_value: t('all.verb.select'), v2__index_selection_cancel_label_value: t('all.verb.cancel'), v2__plannings_index_none_selected_value: t('plannings.index.export.none_planning'), v2__plannings_index_compare_need_selection_value: t('plannings.compare.need_selection'), v2__plannings_index_email_success_value: t('plannings.edit.export.icalendar.success'), v2__plannings_index_email_fail_value: t('plannings.edit.export.icalendar.fail'), v2__plannings_index_callback_url_value: external_callback_customer_path(@customer), v2__plannings_index_api_key_value: current_user.api_key, v2__plannings_index_callback_success_value: t('plannings.edit.export.customer_external_callback_url.success'), v2__plannings_index_callback_fail_value: t('plannings.edit.export.customer_external_callback_url.fail') }}
  .plannings-toolbar.px-3.pt-3
    - if current_user.customer.too_many_plannings?
      .alert.alert-warning{data: { error: 'true' }}
        %p.mb-0= t('plannings.index.over_max_limit', limit: current_user.customer.default_max_plannings)
    .d-flex.justify-content-between.align-items-center.mb-3.flex-wrap.gap-2
      .d-flex.gap-2.align-items-center.flex-wrap
        %h1.mb-0.mt-0= t('plannings.index.title')
        - if show_mutate
          - if cannot_new
            %button.btn.btn-primary{type: 'button', disabled: true, title: t('plannings.index.new')}
              %i.fa.fa-plus.fa-fw
              %span.plannings-btn-label= t('plannings.index.new')
          - else
            = link_to new_planning_path, class: 'btn btn-primary', title: t('plannings.index.new'), data: { turbo: false } do
              %i.fa.fa-plus.fa-fw
              %span.plannings-btn-label= t('plannings.index.new')
          %button.btn.btn-outline-secondary{type: 'button', title: t('all.verb.select'), data: { action: 'v2--index-selection#toggle' }}
            %i.fa.fa-check-square.fa-fw{"aria-hidden": "true"}
            %span.plannings-btn-label{data: { v2__index_selection_target: 'toggleLabel' }}= t('all.verb.select')
          %button.btn.btn-danger{
            type: 'button',
            disabled: true,
            title: t('all.verb.destroy_selection'),
            data: confirm_click_destroy_data(
              group: 'plannings-destroy',
              form: 'plannings-destroy'
            ).merge(v2__table_selection_target: 'bulk')
          }
            %i.fa.fa-trash.fa-fw
            %span.plannings-btn-label= t('all.verb.destroy_selection')
      .d-flex.gap-2.align-items-center.flex-shrink-0
        = text_field_tag :plannings_filter, nil, placeholder: t('all.verb.filter'), class: 'form-control form-control-sm plannings-filter', 'aria-label': t('all.verb.filter'), data: { v2__table_filter_target: 'input', action: 'input->v2--table-filter#filter' }
        = render 'v2/shared/index_count', count: @plannings.size, help: t('plannings.index.plannings_count_help'), model_key: 'activerecord.models.plannings', nowrap: true
  = form_tag plannings_path, method: :delete, id: 'plannings-destroy', data: { turbo_frame: '_top' } do
    #plannings.v2-index-cards.px-3.pb-3{data: { v2__index_selection_target: 'root' }}
      - if show_mutate
        .v2-index-cards-select-bar
          %label.mb-0.d-flex.align-items-center.gap-2
            %input{type: 'checkbox', disabled: !can_destroy, title: t('all.verb.toggle_selection'), data: { v2__table_selection_target: 'all', action: 'change->v2--table-selection#toggleAll' }}
            %span= t('all.verb.select_all')
      - @plannings.each do |planning|
        = render 'v2/plannings/list_row', planning: planning, show_mutate: show_mutate, can_destroy: can_destroy, can_mutate: can_mutate, dashboard_visible: dashboard_visible, dashboard_usable: dashboard_usable
    - unless @plannings.empty?
      .plannings-bulk.px-3.py-2.d-flex.flex-wrap.gap-2.align-items-center
        %button.btn.btn-light{type: 'button', disabled: true, title: t('plannings.compare.action'), data: { v2__table_selection_target: 'bulk', min: '2', action: 'click->v2--plannings-index#compare' }}
          %i.fa.fa-chart-column.fa-fw
          %span.plannings-btn-label= t('plannings.compare.action')
        .dropdown
          %button#btn-export.btn.btn-light.dropdown-toggle{type: 'button', title: t('plannings.index.export_selection'), data: { bs_toggle: 'dropdown' }}
            %i.fa.fa-share-nodes.fa-fw
            %span.plannings-btn-label= t('plannings.index.export_selection')
          %ul.dropdown-menu
            %li
              = link_to api_plannings_calendar_path(api_key: current_user.api_key), id: 'ical_export', class: 'dropdown-item', data: { turbo: false, action: 'click->v2--plannings-index#ical' } do
                %i.fa.fa-calendar.fa-fw
                = t('plannings.index.export.icalendar')
            - if @customer.vehicles.any?(&:contact_email)
              %li
                = link_to api_plannings_calendar_path(api_key: current_user.api_key), class: 'dropdown-item', data: { turbo: false, action: 'click->v2--plannings-index#email' } do
                  %i.fa.fa-envelope.fa-fw
                  = t('plannings.index.export.icalendar_email')
            %li
              %a.dropdown-item{href: '#', data: { action: 'click->v2--plannings-index#spreadsheet' }}
                %i.fa.fa-table.fa-fw
                = t('plannings.index.export.spreadsheet')
            %li
              %a.dropdown-item{href: '#', data: { action: 'click->v2--plannings-index#spreadsheet', summary: 'true' }}
                %i.fa.fa-table.fa-fw
                = t('plannings.index.export.summary_spreadsheet')
        - if @customer.enable_external_callback? && @customer.external_callback_url && callback_visible
          = button_tag type: 'button', id: 'external-url', class: 'btn btn-light', disabled: !callback_usable, title: (@customer.external_callback_name || t('plannings.edit.customer_external_callback_url.action')), data: { action: 'click->v2--plannings-index#callback' } do
            %i.fa.fa-desktop.fa-fw
            %span.plannings-btn-label= @customer.external_callback_name || t('plannings.edit.customer_external_callback_url.action')
  = render 'v2/plannings/spreadsheet_modal', settings: settings, export_stops: export_stops
