-# Copyright © Cartoway
- content_for :title, t('plannings.index.title')
- settings = (current_user.export_settings || {}).stringify_keys
- export_stops = settings.key?('stops') ? Array(settings['stops']) : %w[out-of-route store rest inactive]
- can_destroy = current_user_form_destroy_enabled?(:plannings)
- cannot_new = current_user.customer.too_many_plannings? || !current_user_form_create?(:plannings)
- callback_visible = toolbar_operation_visible?(:planning, 'external_callback')
- callback_usable = toolbar_operation_usable?(:planning, 'external_callback')
- dashboard_visible = toolbar_operation_visible?(:planning, 'planning_dashboard')
- dashboard_usable = toolbar_operation_usable?(:planning, 'planning_dashboard')
.plannings-index{data: { controller: 'v2--table-filter v2--table-selection v2--plannings-index', action: 'turbo:after-stream-render@document->v2--table-filter#filter turbo:after-stream-render@document->v2--table-selection#syncBulk', v2__plannings_index_none_selected_value: t('plannings.index.export.none_planning'), v2__plannings_index_compare_need_selection_value: t('plannings.compare.need_selection'), v2__plannings_index_email_success_value: t('plannings.edit.export.icalendar.success'), v2__plannings_index_email_fail_value: t('plannings.edit.export.icalendar.fail'), v2__plannings_index_callback_url_value: external_callback_customer_path(@customer), v2__plannings_index_api_key_value: current_user.api_key, v2__plannings_index_callback_success_value: t('plannings.edit.export.customer_external_callback_url.success'), v2__plannings_index_callback_fail_value: t('plannings.edit.export.customer_external_callback_url.fail') }}
  .plannings-toolbar.px-3.pt-3
    - if current_user.customer.too_many_plannings?
      .alert.alert-warning{data: { error: 'true' }}
        %p.mb-0= t('plannings.index.over_max_limit', limit: current_user.customer.default_max_plannings)
    .d-flex.justify-content-between.align-items-center.mb-3.flex-wrap.gap-2
      .d-flex.gap-2
        = link_to new_planning_path, class: 'btn btn-primary btn-sm', disabled: cannot_new, data: { turbo: false } do
          %i.fa.fa-plus.fa-fw
          = t('plannings.index.new')
      .d-flex.gap-2.align-items-center
        = text_field_tag :plannings_filter, nil, placeholder: t('all.verb.filter'), class: 'form-control form-control-sm', data: { v2__table_filter_target: 'input', action: 'input->v2--table-filter#filter' }
        %span
          %span{data: { v2__table_filter_target: 'count' }}= @plannings.size
          = t('activerecord.models.plannings', count: @plannings.size)
  = form_tag plannings_path, method: :delete, id: 'plannings-destroy' do
    %table#plannings.table.table-striped.table-hover.table-sm.mb-0
      %thead
        %tr
          %th
            %input{type: 'checkbox', disabled: !can_destroy, title: t('all.verb.toggle_selection'), data: { v2__table_selection_target: 'all', action: 'change->v2--table-selection#toggleAll' }}
          %th= t('activerecord.attributes.planning.name')
          - if @customer.enable_references
            %th= t('activerecord.attributes.planning.ref')
          %th= t('activerecord.attributes.planning.date')
          %th= t('activerecord.attributes.planning.tags')
          %th
      %tbody
        - @plannings.each do |planning|
          %tr{id: dom_id(planning), data: { v2__table_filter_target: 'row' }}
            %td
              = check_box_tag "plannings[#{planning.id}]", planning.id, false, disabled: !can_destroy, data: { v2__table_selection_target: 'row', action: 'change->v2--table-selection#syncBulk' }
            %td= planning.name
            - if @customer.enable_references
              %td= planning.ref
            %td= planning.date && l(planning.date)
            %td
              - planning.tags.each do |tag|
                %span
                  = tag_icon tag
                  %span= tag.label
            %td.plannings-actions-col.text-end.text-nowrap
              .btn-group{role: 'group'}
                - if @reseller.planning_dashboard_url && dashboard_visible
                  = link_to @reseller.planning_dashboard_url.gsub('{LG}', I18n.locale.to_s).gsub('{ID}', current_user.customer.id.to_s).gsub('{P_ID}', planning.id.to_s), target: '_blank', class: 'btn btn-light btn-sm', disabled: !dashboard_usable, data: { turbo: false } do
                    %i.fa.fa-chart-line.fa-fw
                    = t('customers.menu.analytics')
                = link_to planning_duplicate_path(planning), class: 'btn btn-light btn-sm', disabled: current_user.customer.too_many_plannings? || !current_user_planning_form_submit_enabled?(planning), data: { turbo_method: :patch, turbo_frame: '_top' }, title: t('all.verb.duplicate') do
                  %i.fa.fa-copy.fa-fw
                  = t('all.verb.duplicate')
                = link_to edit_planning_path(planning), class: 'btn btn-primary btn-sm', data: { turbo: false }, title: t('all.verb.edit') do
                  %i.fa.fa-pencil.fa-fw
                  = t('all.verb.edit')
                - if can_destroy
                  = link_to planning, class: 'btn btn-danger btn-sm', data: { turbo_method: :delete, turbo_confirm: t('all.verb.destroy_confirm') }, title: t('all.verb.destroy') do
                    %i.fa.fa-trash.fa-fw
                    = t('all.verb.destroy')
                - else
                  %button.btn.btn-danger.btn-sm{type: 'button', disabled: true, title: t('all.verb.destroy')}
                    %i.fa.fa-trash.fa-fw
                    = t('all.verb.destroy')
    - unless @plannings.empty?
      .plannings-bulk.px-3.py-2.d-flex.flex-wrap.gap-2.align-items-center
        = button_tag type: :submit, class: 'btn btn-danger btn-sm', disabled: true, data: { v2__table_selection_target: 'bulk', turbo_confirm: t('all.verb.destroy_confirm') } do
          %i.fa.fa-trash.fa-fw
          = t('all.verb.destroy_selection')
        %button.btn.btn-light.btn-sm{type: 'button', disabled: true, data: { v2__table_selection_target: 'bulk', min: '2', action: 'click->v2--plannings-index#compare' }}
          %i.fa.fa-chart-column.fa-fw
          = t('plannings.compare.action')
        .dropdown
          %button#btn-export.btn.btn-light.btn-sm.dropdown-toggle{type: 'button', data: { bs_toggle: 'dropdown' }}
            %i.fa.fa-share-nodes.fa-fw
            = t('plannings.index.export_selection')
          %ul.dropdown-menu
            %li
              = link_to api_plannings_calendar_path(api_key: current_user.api_key), id: 'ical_export', class: 'dropdown-item', data: { turbo: false, action: 'click->v2--plannings-index#ical' } do
                %i.fa.fa-calendar.fa-fw
                = t('plannings.index.export.icalendar')
            - if @customer.vehicles.any?(&:contact_email)
              %li
                = link_to api_plannings_calendar_path(api_key: current_user.api_key), class: 'dropdown-item', data: { turbo: false, action: 'click->v2--plannings-index#email' } do
                  %i.fa.fa-envelope.fa-fw
                  = t('plannings.index.export.icalendar_email')
            %li
              %a.dropdown-item{href: '#', data: { action: 'click->v2--plannings-index#spreadsheet' }}
                %i.fa.fa-table.fa-fw
                = t('plannings.index.export.spreadsheet')
            %li
              %a.dropdown-item{href: '#', data: { action: 'click->v2--plannings-index#spreadsheet', summary: 'true' }}
                %i.fa.fa-table.fa-fw
                = t('plannings.index.export.summary_spreadsheet')
        - if @customer.enable_external_callback? && @customer.external_callback_url && callback_visible
          = button_tag type: 'button', id: 'external-url', class: 'btn btn-light btn-sm', disabled: !callback_usable, data: { action: 'click->v2--plannings-index#callback' } do
            %i.fa.fa-desktop.fa-fw
            = @customer.external_callback_name || t('plannings.edit.customer_external_callback_url.action')
  = render 'v2/plannings/spreadsheet_modal', settings: settings, export_stops: export_stops
