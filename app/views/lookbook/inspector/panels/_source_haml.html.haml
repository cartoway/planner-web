- scenario = scenarios.first
- source = LookbookDualFormatTemplateResolver.template_source(scenario, :haml)
.h-full
  - if source.present?
    = lookbook_render :code, language: 'haml', line_numbers: true, full_height: true do
      != source
  - else
    %p.text-muted.small.mb-0
      Fichier
      %code .html.haml
      introuvable pour ce scénario.
