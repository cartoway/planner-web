-# Edit form loaded inside turbo-frame#form_sidebar (v2 destinations index right column)
- dest_form_mutable = current_user_destination_form_submit_enabled?(@destination)
= turbo_frame_tag "form_sidebar" do
  %header.destination-form-sidebar-header.mb-3
    %h2.h5.mb-0= t("destinations.edit.title")
  - if flash[:error].present?
    .alert.alert-danger.mb-2{ role: "alert" }= flash[:error]
  - if dest_form_mutable
    .sidebar-destination-form{ data: { controller: "v2--dirty-form-submit" } }
      = render "v2/destinations/form"
      .form-submit-bar.is-hidden{ data: { "v2--dirty-form-submit-target": "bar" } }
        %button.btn.btn-primary{ type: "submit", form: "destination-form-sidebar" }= t("helpers.submit.update", model: @destination.model_name.human)
  - else
    = render "v2/destinations/form"
  -# V2 layout has no Paloma hook; destination.js registers controllers at load time.
  :javascript
    window.Paloma = window.Paloma || { controller: function () {} };
  = javascript_pack_tag "destination", "data-turbolinks-track": "reload"
