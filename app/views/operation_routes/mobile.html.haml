- agent = detect_agent
- route_snap = @operation_route.route_snapshot || {}
- start_depot = @operation_route.depot_for('start')
- end_depot = @operation_route.depot_for('end')
- start_seconds = route_snap['start']
.panel
  .panel-heading.pv-1
    - if @operation_route.ref.present?
      %h4.d-flex.align-items-center.justify-items-center
        .label.label-default.p-3.mr-2
          %i.fa.fa-route.fa-fw
        = @operation_route.ref
    - if @operation_route.vehicle_name.present?
      %h4.d-flex.align-items-center.justify-items-center
        .label.label-default.p-3.mr-2
          %i.fa.fa-truck-field.fa-fw
        = @operation_route.vehicle_name
    %h4.d-flex.align-items-center.justify-items-center
      .label.label-default.p-3.mr-2
        %i.fa.fa-calendar.fa-fw
      = @operation_route.operation.date
    - if start_seconds.present?
      %h4.d-flex.align-items-center.justify-items-center
        .label.label-default.p-3.mr-2
          %i.fa.fa-clock.fa-fw
        = t('routes.mobile.start_time')
        = @operation_route.planned_clock(start_seconds)
    - operation_route_quantities(@operation_route).each do |unit|
      - next if unit[:pickup].blank? && unit[:delivery].blank?
      - [:pickup, :delivery].each do |sym|
        - next if unit[sym].blank? || unit[sym].to_f.zero?
        %h4.d-flex.align-items-center.justify-items-center
          .label.label-default.p-3.mr-2
            %i.fa.fa-fw{ class: unit[:unit_icon] }
          .quantity
            = unit[sym]
            = unit[:label]
            = t("routes.mobile.route_data.#{sym}")
    = render partial: 'custom_attributes/mobile_readonly', locals: { custom_attributes: vehicle_custom_attributes, object: vehicle }
    = render partial: 'custom_attributes/mobile_readonly', locals: { custom_attributes: route_custom_attributes, object: @operation_route }
  .panel-body
    - if is_expired
      .alert.alert-warning
        = t(@operation_route.operation.open? ? 'errors.routes.expired' : 'errors.routes.historized')
    - else
      #accordion.panel-group.route-stops{ role: 'tablist', aria_multiselectable: 'true' }
        - previous = nil
        - if start_depot
          - next_status = { 'atstore' => 'finished', nil => 'atstore' }[@operation_route.departure_status]
          - start_status_class = @operation_route.departure_status.presence || 'neutral'
          .panel.panel-default{ data: { stop_type: 'store' } }
            .panel-heading{ id: "heading-start-route-data", role: 'tab', style: "padding: 5px", class: "panel-heading-#{start_status_class}", href: "#collapse-start-route-data", data: { toggle: 'collapse', parent: '#accordion'} }
              .d-flex.align-items-center.justify-content-between.mb-1
                .col-xs-2.p-0
                  .d-flex.align-items-center.justify-content-between
                    .stop-status-label-wrap
                      #label-index.label.label-default-negative.p-3{ class: "label-#{start_status_class}" }
                        %i.fa.fa-fw.fa-warehouse
                      %button.stop-status-reset.no-toggle{ type: 'button', title: t('plannings.edit.stop_status.none'), class: ('d-none' if @operation_route.departure_status.blank?), data: { toggle: 'route_start_route_data_status', next_status: 'atstore', wait_message: t('all.verb.destroy_confirm_wait'), confirm_message: t('stops.mobile.status_reset_confirm'), ready_html: %(<i class="fa fa-check" aria-hidden="true"></i>) } }
                        %span.stop-status-reset-face.btn.btn-xs.btn-default
                          %i.fa.fa-xmark
                .col-xs-6.p-0
                  = t('routes.mobile.start_depot')
                .col-xs-4.p-0
                  %a#quick-status.col-xs-12.col-sm-6.btn.btn-default.no-toggle.mr-2.pull-right{ class: "#{' d-none' unless next_status}", data: { toggle: 'route_start_route_data_status', title: next_status } }
                    .d-flex.align-items-center
                      .fa.fa-regular.fa-square-caret-right.mr-2
                      #quick-status-text
                        = t("plannings.edit.stop_store_status.#{next_status}") if next_status
              .d-flex.align-items-center
                .col-xs-12.p-0.mt-1
                  .d-flex.align-items-center.justify-content-between
                    .col-xs-8.p-0.mr-2
                      = start_depot[:address]
                    .col-xs-4.p-0
                      - if start_depot[:lat].present? && start_depot[:lng].present?
                        = render partial: 'stops/mobile_navigate', locals: { lat: start_depot[:lat], lng: start_depot[:lng], agent: agent }
              .d-flex.align-items-center.justify-content-center
                .fa.fa-caret-down.fa-fw
            .panel-collapse.collapse.in{ id: "collapse-start-route-data", role: 'tabpanel' }
              .panel-body
                = render partial: 'operation_routes/mobile_depot', locals: { status_context: 'start_route_data', status: @operation_route.departure_status, custom_attributes: start_route_data_custom_attributes, related_field: 'start_route_data' }
          - previous = start_depot
        - @stops.each do |stop|
          - next unless stop.active

          - if stop.kind == 'visit'
            = render partial: 'stops/mobile_stop_visit', locals: { stop: stop, previous: previous, agent: agent, customer: customer, enable_driver_move: enable_driver_move, custom_attributes: stop_visit_custom_attributes, visit_custom_attributes: visit_custom_attributes }
          - elsif stop.kind == 'store'
            = render partial: 'stops/mobile_stop_store', locals: { stop: stop, previous: previous, agent: agent, customer: customer, custom_attributes: stop_store_custom_attributes }
          - elsif stop.kind == 'rest'
            = render partial: 'stops/mobile_stop_rest', locals: { stop: stop, previous: previous, agent: agent, customer: customer }
          - previous = stop
        - if end_depot
          - next_status = { 'intransit' => 'atstore', 'atstore' => 'finished', nil => 'intransit' }[@operation_route.arrival_status]
          - stop_status_class = @operation_route.arrival_status.presence || 'neutral'
          .panel.panel-default{ data: { stop_type: 'store' } }
            .panel-heading{ id: "heading-stop-route-data", role: 'tab', style: "padding: 5px", class: "panel-heading-#{stop_status_class}", href: "#collapse-stop-route-data", data: { toggle: 'collapse', parent: '#accordion'} }
              .d-flex.align-items-center.justify-content-between.mb-1
                .col-xs-2.p-0
                  .d-flex.align-items-center.justify-content-between
                    .stop-status-label-wrap
                      #label-index.label.label-default-negative.p-3{ class: "label-#{stop_status_class}" }
                        %i.fa.fa-fw.fa-warehouse
                      %button.stop-status-reset.no-toggle{ type: 'button', title: t('plannings.edit.stop_status.none'), class: ('d-none' if @operation_route.arrival_status.blank?), data: { toggle: 'route_stop_route_data_status', next_status: 'intransit', wait_message: t('all.verb.destroy_confirm_wait'), confirm_message: t('stops.mobile.status_reset_confirm'), ready_html: %(<i class="fa fa-check" aria-hidden="true"></i>) } }
                        %span.stop-status-reset-face.btn.btn-xs.btn-default
                          %i.fa.fa-xmark
                .col-xs-6.p-0
                  = t('routes.mobile.stop_depot')
                .col-xs-4.p-0
                  %a#quick-status.col-xs-12.col-sm-6.btn.btn-default.no-toggle.mr-2.pull-right{ class: "#{' d-none' unless next_status}", data: { toggle: 'route_stop_route_data_status', title: next_status } }
                    .d-flex.align-items-center
                      .fa.fa-regular.fa-square-caret-right.mr-2
                      #quick-status-text
                        = t("plannings.edit.stop_store_status.#{next_status}") if next_status
              .d-flex.align-items-center
                .col-xs-12.p-0.mt-1
                  .d-flex.align-items-center.justify-content-between
                    .col-xs-8.p-0.mr-2
                      = end_depot[:address]
                    .col-xs-4.p-0
                      - if end_depot[:lat].present? && end_depot[:lng].present?
                        = render partial: 'stops/mobile_navigate', locals: { lat: end_depot[:lat], lng: end_depot[:lng], agent: agent }
              .d-flex.align-items-center.justify-content-center
                .fa.fa-caret-down.fa-fw
            .panel-collapse.collapse{ id: "collapse-stop-route-data", role: 'tabpanel' }
              .panel-body
                = render partial: 'operation_routes/mobile_depot', locals: { status_context: 'stop_route_data', status: @operation_route.arrival_status, custom_attributes: stop_route_data_custom_attributes, related_field: 'stop_route_data' }
        - if @stops.empty?
          .alert.alert-warning
            = t("routes.mobile.empty_route")

  .row
    #mobile-sync-pending.d-none.fixed-spinner-container.alert.alert-warning.mb-0
      .d-flex.align-items-center.justify-content-center.gap-2.py-2
        %i.fa.fa-spinner.fa-spin.fa-fw{"aria-hidden": "true"}
        %span= t('routes.mobile.sync_pending')
    #mobile-sync-failed.d-none.fixed-spinner-container.alert.alert-danger.mb-0
      .d-flex.align-items-center.justify-content-center.py-2
        %span= t('routes.mobile.sync_failed')
