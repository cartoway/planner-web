-# Partial for rendering an OperationStop (store) in the mobile route view
- next_status = { 'intransit' => 'atstore', 'atstore' => 'finished', nil => 'intransit' }[stop.status]

.panel.panel-default{ data: { stop_type: 'store' } }
  .panel-heading{ id: ("heading-#{stop.id}"), role: 'tab', style: "padding: 5px", class: "panel-heading-#{stop.status.presence || 'neutral'}", href: ("#collapse-#{stop.id}"), data: { toggle: 'collapse', parent: '#accordion'} }
    .d-flex.align-items-center.justify-content-between.mb-1
      .col-xs-2.p-0
        .d-flex.align-items-center.justify-content-between
          .stop-status-label-wrap
            #label-index.label.label-default-negative.p-3{ class: ("label-#{stop.status.presence || 'neutral'}") }
              %i.fa.fa-fw{ class: stop.mobile_icon }
            %button.stop-status-reset.no-toggle{ type: 'button', title: t('plannings.edit.stop_status.none'), class: ('d-none' if stop.status.blank?), data: { toggle: 'active_status', next_status: 'intransit', wait_message: t('all.verb.destroy_confirm_wait'), confirm_message: t('stops.mobile.status_reset_confirm'), ready_html: %(<i class="fa fa-check" aria-hidden="true"></i>) } }
              %span.stop-status-reset-face.btn.btn-xs.btn-default
                %i.fa.fa-xmark
      .col-xs-6.p-0
        = stop.name
      .col-xs-4.p-0
        %a#quick-status.col-xs-12.col-sm-6.btn.btn-default.no-toggle.mr-2.pull-right{ class: "#{' d-none' unless next_status}", data: { toggle: 'active_status', title: next_status } }
          .d-flex.align-items-center
            .fa.fa-regular.fa-square-caret-right.mr-2
            #quick-status-text
              = t("plannings.edit.stop_store_status.#{next_status}") if next_status
    .d-flex.align-items-center
      .col-xs-12.p-0.mt-1
        .d-flex.align-items-center.justify-content-between
          .col-xs-8.p-0.mr-2
            = stop.street
            = stop.postalcode
            = stop.city
          .col-xs-4.p-0
            - if stop.position?
              = render partial: 'stops/mobile_navigate', locals: { lat: stop.lat, lng: stop.lng, agent: agent }
    .d-flex.align-items-center.justify-content-center
      .fa.fa-caret-down.fa-fw
  .panel-collapse.collapse{ id: ("collapse-#{stop.id}"), role: 'tabpanel', class: ('in' unless previous) }
    .panel-body
      .container.mt-1
        = form_with url: operation_stop_path(stop), method: :patch, local: true, html: { class: 'operation-stop-status-form' } do
          .form-group.mb-1
            %label{ for: 'active_status' }
              = t('stops.mobile.status')
            .input-group.col-xs-12
              .radiobtn
                .d-flex.align-items-center.justify-content-between{ style: 'width: 100%'}
                  .col-xs-6.d-flex.justify-content-center
                    %a.btn.btn-primary{ data: { toggle: 'active_status', title: 'intransit' }, class: ('active' if stop.status == 'intransit') }
                      = t('plannings.edit.stop_store_status.intransit')
                  .col-xs-6.d-flex.justify-content-center
                    %a.btn.btn-info{ data: { toggle: 'active_status', title: 'atstore' }, class: ('active' if stop.status == 'atstore') }
                      = t('plannings.edit.stop_store_status.atstore')
                .d-flex.align-items-center.justify-content-between
                  .col-xs-6.d-flex.justify-content-center
                  .col-xs-6.d-flex.justify-content-center
                    %a.btn.btn-success{ data: { toggle: 'active_status', title: 'finished' }, class: ('active' if stop.status == 'finished') }
                      = t('plannings.edit.stop_store_status.finished')
              = hidden_field_tag 'operation_stop[status]', stop.status, id: 'active_status'
              = hidden_field_tag 'operation_stop[status_updated_at]', ''
        - if custom_attributes.any?
          = bootstrap_form_for stop, url: operation_stop_path(stop), method: :patch, remote: true, as: :operation_stop do |f|
            %label
              = t('routes.mobile.form')
            - custom_attributes.each do |custom_attribute|
              .custom_field.d-flex.align-items-center.justify-content-left.mb-1.row
                %label{class: custom_attribute.object_type == 'boolean' ? 'col-xs-8' : 'col-xs-12' }
                  = custom_attribute.name
                .field.mb-0{class: custom_attribute.object_type == 'boolean' ? 'col-xs-4' : 'col-xs-12' }
                  = custom_attribute_form_field(f, stop, custom_attribute, 'operation_stop')
                .col-xs-12
                  %p.help-block
                    = custom_attribute.description
        = render partial: 'stops/documents', locals: { stop: stop, customer: customer, confirm_photo_delete: true }
