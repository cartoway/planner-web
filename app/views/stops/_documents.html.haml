- return unless stop.is_a?(OperationStop)
- customer = stop.operation_route.operation.customer
- proofs_enabled = customer.enable_proofs?
- photos = stop.serialized_photos
- signature = stop.serialized_signature
- docs_count = photos.size + (signature ? 1 : 0)
.stop-documents
  - if proofs_enabled
    .stop-photos{ data: { url: operation_stop_photos_path(stop) } }
      %label= t('stops.mobile.photos')
      .stop-photos-actions
        %label.btn.btn-default.stop-photos-pick.mb-0
          .d-flex.align-items-center.justify-content-center
            %i.fa.fa-camera.mr-2
            = t('stops.mobile.take_photo')
          %input.stop-photos-input.stop-photos-camera-input{ type: 'file', accept: 'image/*', capture: 'environment', name: 'photos[]' }
        %label.btn.btn-default.stop-photos-pick.mb-0
          .d-flex.align-items-center.justify-content-center
            %i.fa.fa-folder-open.mr-2
            = t('stops.mobile.from_storage')
          %input.stop-photos-input.stop-photos-gallery-input{ type: 'file', accept: 'image/*', multiple: true, name: 'photos[]' }
    .stop-signature{ data: { url: operation_stop_signature_path(stop) } }
      %label= t('stops.mobile.signature')
      %button.btn.btn-default.btn-block.stop-signature-open{ type: 'button' }
        %i.fa.fa-signature.fa-fw
        = t('stops.mobile.signature_open')
  .stop-documents-accordion{ class: ('d-none' if docs_count.zero?) }
    %button.stop-documents-toggle.btn.btn-default{ type: 'button', class: ('d-none' if docs_count.zero?) }
      .d-flex.align-items-center.justify-content-between
        %span
          = t('stops.mobile.documents_loaded')
          %span.stop-documents-badge= docs_count
        %i.fa.fa-caret-down.fa-fw
    .stop-documents-panel{ id: "documents-panel-OperationStop-#{stop.id}" }
      .stop-documents-body{ class: ('d-none' if docs_count.zero?) }
        .stop-documents-list
          - photos.each do |photo|
            .stop-photo
              - if photo[:deletable]
                %button.stop-photo-remove.btn.btn-xs.btn-default{ type: 'button', data: { url: operation_stop_photo_path(stop, photo[:id]) } }
                  %i.fa.fa-trash
              %button.stop-photo-open{ type: 'button', data: { url: photo[:url] } }
                %img{ src: photo[:url], alt: photo[:filename] }
          - if signature
            .stop-photo.stop-signature-doc
              %button.stop-photo-open{ type: 'button', data: { url: signature[:url] } }
                %img{ src: signature[:url], alt: signature[:filename] }
