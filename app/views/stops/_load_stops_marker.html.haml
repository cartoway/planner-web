- if !route[:with_stops] && route[:size].to_i > 0
  - if planning_stops_preload_manual?
    .d-flex.justify-content-center.load-stops
      %button.btn.btn-default{ title: t("plannings.edit.without_stops_title") }
        %i.fa.fa-rectangle-list.fa-fw
        = t("plannings.edit.load_stops")
  - else
    .d-flex.justify-content-center.load-stops.load-stops-auto.text-muted
      %span
        %i.fa.fa-spinner.fa-spin.fa-fw
        = t("plannings.edit.load_stops")
