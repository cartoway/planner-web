<% javascript 'tag' %>

<% content_for :title, t('.title') %>

<h1><%= t '.title' %></h1>

<% show_mutate_tags = current_user_space_action_visible?(:tags, :edit) %>
<% can_mutate_tags = current_user_space_action_usable?(:tags, :edit) %>

<div class="row row-top">
  <div class="col-md-6">
    <% if show_mutate_tags %>
      <% if can_mutate_tags %>
        <%= link_to new_tag_path, class:"btn btn-primary btn-sm" do %><i class="fa fa-plus fa-fw"></i> <%= t '.new' %><% end %>
      <% else %>
        <button type="button" class="btn btn-primary btn-sm" disabled><i class="fa fa-plus fa-fw"></i> <%= t '.new' %></button>
      <% end %>
    <% end %>
  </div>
  <div class="col-md-6">
    <div class="form-inline pull-right">
      <%= text_field_tag :tags_filter, nil, placeholder: t('all.verb.filter'), class: 'form-control', 'data-change' => 'filter', 'data-target' => '#tags' %>
      <span id="tags_count"><%= @tags.count %></span> <%= t 'activerecord.models.tags', count: @tags.count %>
    </div>
  </div>
</div>

<%= form_tag tags_path, method: :delete do %>
<table id="tags" class="table table-striped table-hover">
  <thead>
    <tr>
      <th><% if show_mutate_tags %><button type="button" class="btn btn-default btn-xs" data-toggle="selection" data-target="#tags" title="<%= t 'all.verb.toggle_selection' %>"<%= ' disabled' unless can_mutate_tags %>><i class="fa fa-check fa-fw"></i></button><% end %></th>
      <th><%= t 'activerecord.attributes.tag.label' %></th>
      <th><%= t 'activerecord.attributes.tag.icon' %></th>
      <th><%= t 'activerecord.attributes.tag.ref' %></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @tags.each do |tag| %>
      <tr>
        <td><% if show_mutate_tags %><%= check_box_tag("tags[#{tag.id}]", '1', false, 'data-toggle' => 'disable-multiple-actions', 'data-target' => '#multiple-actions', disabled: !can_mutate_tags) %><% end %></td>
        <td><%= tag.label %></td>
        <td><%= tag_icon tag %></td>
        <td><%= tag.ref %></td>
        <td class="text-right">
          <% if show_mutate_tags %>
            <% if can_mutate_tags %>
              <%= link_to edit_tag_path(tag), :class => 'btn btn-primary btn-sm' do %><i class="fa fa-edit fa-fw"></i> <%= t 'all.verb.edit' %><% end %>
              <%= link_to tag, :class => 'btn btn-danger btn-sm', method: :delete, data: { confirm: t('all.verb.destroy_confirm') } do %><i class="fa fa-trash fa-fw"></i> <%= t 'all.verb.destroy' %><% end %>
            <% else %>
              <button type="button" class="btn btn-primary btn-sm" disabled><i class="fa fa-edit fa-fw"></i> <%= t 'all.verb.edit' %></button>
              <button type="button" class="btn btn-danger btn-sm" disabled><i class="fa fa-trash fa-fw"></i> <%= t 'all.verb.destroy' %></button>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% unless @tags.empty? %>
<div id="multiple-actions" class="row">
  <div class="col-md-12">
    <% if show_mutate_tags %>
      <%= button_tag type: :submit, class: "btn btn-danger btn-sm", disabled: !can_mutate_tags, data: { confirm: t('all.verb.destroy_confirm') } do %><i class="fa fa-trash fa-fw"></i> <%= t('all.verb.destroy_selection') %><% end %>
    <% end %>
  </div>
</div>
<% end %>

<% end %>
