= turbo_frame_tag "form_sidebar" do
  %header.mb-3
    %h2.h5.mb-0= t("vehicle_usage_sets.new.title")
  - if current_user.customer.too_many_vehicle_usage_sets?
    .alert.alert-warning
      %p.mb-0= t 'vehicle_usage_sets.index.over_max_limit', limit: current_user.customer.default_max_vehicle_usage_sets
  - else
    .sidebar-form
      = render "v2/vehicle_usage_sets/form", v2_js_config: { customer_id: current_user.customer.id }.to_json
      .form-submit-bar
        %button.btn.btn-primary{type: 'submit', form: 'vehicle-usage-set-form-sidebar', disabled: !current_user_form_create?(:vehicle_usages)}
          %i.fa.fa-floppy-disk.fa-fw
          = t('helpers.submit.create', model: VehicleUsageSet.model_name.human)
