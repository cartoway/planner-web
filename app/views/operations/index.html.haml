- content_for :title, t('operations.index.title')
- show_destroy = current_user_space_action_visible?(:operations, :destroy)
- can_destroy = current_user_space_action_usable?(:operations, :destroy)
- show_export = current_user_space_action_visible?(:operations, :export)
- can_export = current_user_space_action_usable?(:operations, :export)
- show_planning = current_user_space_visible?(:plannings)
- can_planning = current_user_space_usable?(:plannings)
- filter_chips = [{ value: '', label: t('operations.index.chip_all') }, { value: 'in_progress', label: t('operations.statuses.in_progress') }, { value: 'historized', label: t('operations.statuses.historized') }]
.operations-index.pt-3
  .px-3
    .d-flex.justify-content-between.align-items-center.mb-3.flex-wrap.gap-2
      %h1.h3.mb-0= t('operations.index.title')
      = render 'v2/shared/index_count', count: @operations.size, help: t('operations.index.operations_count_help'), model_key: 'activerecord.models.operations', filterable: false
    = render 'v2/shared/list_filters', url: operations_path, q: params[:q], date: params[:date], status: params[:status], search_placeholder: t('operations.index.search_placeholder'), chips: filter_chips
  .v2-index-cards.v2-index-cards--with-mid.px-3.pb-3
    - if @operations.empty?
      %p.v2-index-card-empty.text-muted.mb-0= t('operations.index.empty')
    - @operations.each do |operation|
      - counts = operation.board_counts
      - modal_id = "operation-destroy-#{operation.id}"
      .v2-index-card
        .v2-index-card-main
          .v2-index-card-body
            .v2-index-card-header
              %h2.v2-index-card-title= operation.name
              .v2-index-card-badges
                - if operation.open?
                  %span.badge.text-bg-primary= t('operations.statuses.in_progress')
                  - if operation.current_structure?
                    %span.badge.text-bg-success= t('execution.badge_fresh')
                  - else
                    %span.badge.text-bg-warning= t('execution.badge_dirty')
                - else
                  %span.badge.text-bg-secondary= t('operations.statuses.historized')
            .v2-index-card-meta.text-muted
              - if operation.ref.present?
                %span= operation.ref
                %span ·
              %span= l(operation.date)
        .v2-index-card-mid
          = render 'v2/shared/status_segments', counts: counts
          %span.operations-index-progress-label.text-muted= t('operations.index.stops_count', treated: counts[:delivered] + counts[:failed] + counts[:exception], total: counts[:total])
        .v2-index-card-actions.v2-index-card-actions--slots
          = link_to operation_path(operation), class: (operation.open? ? 'btn btn-primary' : 'btn btn-secondary'), data: { turbo_frame: 'main', turbo_action: 'advance' } do
            %i.fa.fa-tower-broadcast.fa-fw
            = t('execution.open_tracking')
          .v2-index-card-secondary
            - if show_export
              .dropdown
                %button.btn.btn-secondary.dropdown-toggle{type: 'button', disabled: !can_export, data: (can_export ? { bs_toggle: 'dropdown' } : {}), aria: { expanded: 'false' }}
                  %i.fa.fa-download.fa-fw
                  = t('operations.show.export')
                - if can_export
                  %ul.dropdown-menu
                    %li
                      = link_to export_operation_path(operation, format: :xlsx), class: 'dropdown-item', data: { turbo: false } do
                        %i.fa.fa-file-excel.fa-fw
                        = t('operations.show.export_spreadsheet')
                    %li
                      = link_to export_operation_path(operation, format: :zip), class: 'dropdown-item', data: { turbo: false } do
                        %i.fa.fa-file-zipper.fa-fw
                        = t('operations.show.export_archive')
            - if operation.planning && show_planning
              - planning_label = operation.planning.ref.presence || operation.planning.name
              - if can_planning
                = link_to edit_planning_path(operation.planning), class: 'btn btn-secondary', target: '_blank', rel: 'noopener', data: { turbo: false }, title: planning_label do
                  %i.fa.fa-map-location.fa-fw
                  %span.v2-index-card-secondary-label= planning_label
              - else
                %button.btn.btn-secondary{type: 'button', disabled: true, title: planning_label}
                  %i.fa.fa-map-location.fa-fw
                  %span.v2-index-card-secondary-label= planning_label
            - if show_destroy
              %button.btn.btn-danger{type: 'button', disabled: !can_destroy, data: (can_destroy ? { bs_toggle: 'modal', bs_target: "##{modal_id}" } : {})}
                %i.fa.fa-trash.fa-fw
                = t('all.verb.destroy')
  - if can_destroy
    - @operations.each do |operation|
      = render 'v2/shared/typed_confirm_modal', id: "operation-destroy-#{operation.id}", expected: operation.name, url: operation_path(operation), title: t('operations.index.destroy_title'), body: t('operations.index.destroy_body', name: operation.name), confirm_label: t('operations.index.destroy_confirm'), input_label: t('operations.index.destroy_input_label')
