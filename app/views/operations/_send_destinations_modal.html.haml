- channels = destination_contact_channels(operation.customer)
- groups = operation_destination_contact_groups(trackings)
- rows = groups.flat_map { |group| group[:rows] }
- count_channel = channels.first || :email
- filled = contact_rows_filled_count(rows, count_channel)
- total = rows.size
.modal.fade#operation-send-destinations{tabindex: '-1', aria: { hidden: 'true', labelledby: 'operation-send-destinations-title' }}
  .modal-dialog.modal-xl.modal-dialog-scrollable
    .modal-content
      = form_with url: transmit_destinations_operation_path(operation), method: :post, local: true, html: { class: 'operation-send-form' }, data: { turbo: false } do
        .modal-header
          %h2.h5.modal-title#operation-send-destinations-title.d-flex.align-items-center.gap-2
            %span= t('operations.show.send_destinations_title')
            %span.badge{class: contact_rows_count_badge_class(filled, total), data: { contacts_total_count: true }}= "#{filled}/#{total}"
          %button.btn-close{type: 'button', data: { bs_dismiss: 'modal' }, aria: { label: t('web.dialog.close') }}
        .modal-body
          = render 'operations/contacts_list',
            groups: groups,
            mode: :destinations,
            channels: channels,
            param_namespace: 'trackings',
            allow_reorder: false
        .modal-footer
          %button.btn.btn-light{type: 'button', data: { bs_dismiss: 'modal' }}= t('all.verb.cancel')
          = submit_tag t('operations.show.send_destinations'), class: 'btn btn-primary'
