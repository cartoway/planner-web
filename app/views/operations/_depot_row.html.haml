- title = t(label_key)
- status_label = depot[:status].present? ? route.depot_status_label(depot[:status]) : nil
- depot_url = depot_operation_operation_route_path(operation, route, role: role)
%li.operation-depot-row.operation-stop-row{data: { phase: 'depot', label: depot[:name], lat: depot[:lat], lng: depot[:lng], url: depot_url, action: 'click->v2--operation-show#selectDepot' }}
  %span.operation-glyph.is-depot{title: title}
    %i.fa.fa-house
  .operation-stop-main.min-w-0
    .operation-stop-name= depot[:name]
    .operation-stop-clock= depot[:time]
  - if status_label
    .operation-stop-aside
      %span.operation-gap= status_label
