- channels = driver_contact_channels(operation.customer)
- rows = operation_driver_contact_rows(routes)
- count_channel = channels.first || :email
- filled = contact_rows_filled_count(rows, count_channel)
- total = rows.size
.modal.fade#operation-send-drivers{tabindex: '-1', aria: { hidden: 'true', labelledby: 'operation-send-drivers-title' }}
  .modal-dialog.modal-xl.modal-dialog-scrollable
    .modal-content
      = form_with url: transmit_operation_path(operation), method: :post, local: true, html: { class: 'operation-send-form' }, data: { turbo: false } do
        .modal-header
          %h2.h5.modal-title#operation-send-drivers-title.d-flex.align-items-center.gap-2
            %span= t('operations.show.send_drivers_title')
            %span.badge{class: contact_rows_count_badge_class(filled, total), data: { contacts_total_count: true }}= "#{filled}/#{total}"
          %button.btn-close{type: 'button', data: { bs_dismiss: 'modal' }, aria: { label: t('web.dialog.close') }}
        .modal-body
          = render 'operations/contacts_list',
            rows: rows,
            mode: :drivers,
            channels: channels,
            param_namespace: 'routes',
            allow_reorder: true
        .modal-footer
          %button.btn.btn-light{type: 'button', data: { bs_dismiss: 'modal' }}= t('all.verb.cancel')
          = submit_tag t('operations.show.send_drivers'), class: 'btn btn-primary'
