- if @manage_planning[:manage_route_export_menu] || @manage_planning[:manage_route_export_print_only]
  - export_dis = @manage_planning[:disable_route_export]
  - if @manage_planning[:manage_route_export_menu]
    %button.btn.btn-default.btn-xs.dropdown-toggle{"data-toggle" => "dropdown", title: t('plannings.edit.export_help'), type: "button", disabled: export_dis}
      %i.fa.fa-share-nodes
      %span.caret
    %ul.dropdown-menu.pull-right{role: "menu"}
      - if @manage_planning[:manage_route_external_callback]
        %li{class: [('disabled' if @manage_planning[:disable_route_external_callback]), 'link', 'customer_external_callback_url'].compact.join(' '), data: {customer_id: current_user.customer.id, planning_id: summary[:planning_id], route_id: route[:route_id]}}
          %i.fa.fa-desktop.fa-fw
          - if summary[:external_callback_name]
            = summary[:external_callback_name]
          - else
            = t('plannings.edit.customer_external_callback_url.action')
        %li.divider{role: "separator"}
      %li
        %a{href: "/api-web/0.1/plannings/#{summary[:planning_id]}/routes/#{route[:route_id]}/print", target: "_blank"}
          %i.fa.fa-print.fa-fw
          = t('plannings.edit.export.print')
      %li.divider{role: "separator"}
      %li
        %a.export_spreadsheet
          %i.fa.fa-table.fa-fw
          = t('plannings.edit.export.spreadsheet')
      %li.divider{role: "separator"}
      %li
        %a{href: route[:calendar_url_api_key]}
          %i.fa.fa-calendar.fa-fw
          = t('plannings.edit.export.icalendar.action')
      - if route[:contact_email]
        %li.icalendar_email{"data-email" => "true"}
          %a{href: route[:calendar_url]}
            %i.fa.fa-envelope.fa-fw
            = t('plannings.edit.export.icalendar.action_email')
  - elsif @manage_planning[:manage_route_export_print_only]
    - print_href = "/api-web/0.1/plannings/#{summary[:planning_id]}/routes/#{route[:route_id]}/print"
    - if export_dis
      %span.btn.btn-default.btn-xs.disabled{title: t('plannings.edit.export.print')}
        %i.fa.fa-print.fa-fw
    - else
      %a.btn.btn-default.btn-xs{href: print_href, target: "_blank", title: t('plannings.edit.export.print')}
        %i.fa.fa-print.fa-fw
