<% local_assigns[:updated_routes]&.each do |route| %>
  <% if route[:vehicle_usage_id] %>
    $('ol.routes').find("li.route[data-route-id='<%= route[:route_id] %>']").html("<%= j(render partial: 'routes/in_route', formats: [:html], locals: { route: route, summary: local_assigns[:summary] }) %>");
  <% else %>
    $('ol.routes.out_routes').find('li.route').html("<%= j(render partial: 'routes/out_of_route', formats: [:html], locals: local_assigns) %>");
  <% end %>
<% end %>
var locals = <%= local_assigns.to_json.html_safe %>;
