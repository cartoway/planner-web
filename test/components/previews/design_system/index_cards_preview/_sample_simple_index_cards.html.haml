-# locals: variant: ('operations' | 'capacites')
- variant = local_assigns.fetch(:variant, 'operations')
- if variant.to_s == 'capacites'
  .v2-index-cards.lookbook-deliverable-units-cards.px-2.pb-2
    .v2-index-card
      .v2-index-card-main
        .v2-index-card-body
          .v2-index-card-header
            %h2.v2-index-card-title
              %i.fa.fa-dumpster.fa-fw{"aria-hidden": "true"}
              kg
          .v2-index-card-meta.text-muted
            %span.v2-index-card-meta-item.du-meta-ref
              %span.v2-index-card-meta-label= "#{DeliverableUnit.human_attribute_name(:ref)} :"
              %span.v2-index-card-meta-value ref_kg
            %span.v2-index-card-meta-item.du-meta-capacity
              %span.v2-index-card-meta-label= "#{DeliverableUnit.human_attribute_name(:default_capacity)} :"
              %span.v2-index-card-meta-value 100
            %span.v2-index-card-meta-item.du-meta-delivery
              %span.v2-index-card-meta-label= "#{DeliverableUnit.human_attribute_name(:default_delivery)} :"
              %span.v2-index-card-meta-value 0
            %span.v2-index-card-meta-item.du-meta-pickup
              %span.v2-index-card-meta-label= "#{DeliverableUnit.human_attribute_name(:default_pickup)} :"
              %span.v2-index-card-meta-value 0
            %span.v2-index-card-meta-item.du-meta-overload
              %span.v2-index-card-meta-label= "#{DeliverableUnit.human_attribute_name(:optimization_overload_multiplier)} :"
              %span.v2-index-card-meta-value 1,5
      .v2-index-card-actions
        %button.btn.btn-primary{type: 'button', title: t('all.verb.edit')}
          %i.fa.fa-pencil.fa-fw
          = t('all.verb.edit')
        %button.btn.btn-danger{type: 'button', title: t('all.verb.destroy')}
          %i.fa.fa-trash.fa-fw
          = t('all.verb.destroy')
    .v2-index-card
      .v2-index-card-main
        .v2-index-card-body
          .v2-index-card-header
            %h2.v2-index-card-title
              %i.fa.fa-dumpster.fa-fw{"aria-hidden": "true"}
              L
          .v2-index-card-meta.text-muted
            %span.v2-index-card-meta-item.du-meta-ref
              %span.v2-index-card-meta-label= "#{DeliverableUnit.human_attribute_name(:ref)} :"
              %span.v2-index-card-meta-value ref_L
            %span.v2-index-card-meta-item.du-meta-capacity
              %span.v2-index-card-meta-label= "#{DeliverableUnit.human_attribute_name(:default_capacity)} :"
              %span.v2-index-card-meta-value 50
            %span.v2-index-card-meta-item.du-meta-delivery
            %span.v2-index-card-meta-item.du-meta-pickup
            %span.v2-index-card-meta-item.du-meta-overload
      .v2-index-card-actions
        %button.btn.btn-primary{type: 'button', title: t('all.verb.edit')}
          %i.fa.fa-pencil.fa-fw
          = t('all.verb.edit')
        %button.btn.btn-danger{type: 'button', title: t('all.verb.destroy')}
          %i.fa.fa-trash.fa-fw
          = t('all.verb.destroy')
- else
  -# Mirrors app/views/operations/index.html.haml (static demo data).
  - filter_chips = [{ value: '', label: t('operations.index.chip_all') }, { value: 'in_progress', label: t('operations.statuses.in_progress') }, { value: 'historized', label: t('operations.statuses.historized') }]
  - open_counts = { delivered: 12, failed: 2, exception: 1, rest: 5, total: 20 }
  - done_counts = { delivered: 20, failed: 0, exception: 0, rest: 0, total: 20 }
  .operations-index.pt-3
    .px-3
      .d-flex.justify-content-between.align-items-center.mb-3.flex-wrap.gap-2
        %h1.h3.mb-0= t('operations.index.title')
        = render 'v2/shared/index_count', count: 2, help: t('operations.index.operations_count_help'), model_key: 'activerecord.models.operations', filterable: false
      = render 'v2/shared/list_filters', url: '#', q: nil, date: nil, status: '', search_placeholder: t('operations.index.search_placeholder'), chips: filter_chips
    .v2-index-cards.v2-index-cards--with-mid.px-3.pb-3
      .v2-index-card
        .v2-index-card-main
          .v2-index-card-body
            .v2-index-card-header
              %h2.v2-index-card-title Tournée du matin
              .v2-index-card-badges
                %span.badge.text-bg-primary= t('operations.statuses.in_progress')
                %span.badge.text-bg-success= t('execution.badge_fresh')
            .v2-index-card-meta.text-muted
              %span REF-42
              %span ·
              %span 15/10/2026
        .v2-index-card-mid
          = render 'v2/shared/status_segments', counts: open_counts
          %span.operations-index-progress-label.text-muted= t('operations.index.stops_count', treated: 15, total: 20)
        .v2-index-card-actions.v2-index-card-actions--slots
          %a.btn.btn-primary{href: '#'}
            %i.fa.fa-tower-broadcast.fa-fw
            = t('execution.open_tracking')
          .v2-index-card-secondary
            .dropdown
              %button.btn.btn-secondary.dropdown-toggle{type: 'button', data: { bs_toggle: 'dropdown' }, aria: { expanded: 'false' }}
                %i.fa.fa-download.fa-fw
                = t('operations.show.export')
              %ul.dropdown-menu
                %li
                  %a.dropdown-item{href: '#'}
                    %i.fa.fa-file-excel.fa-fw
                    = t('operations.show.export_spreadsheet')
                %li
                  %a.dropdown-item{href: '#'}
                    %i.fa.fa-file-zipper.fa-fw
                    = t('operations.show.export_archive')
            %a.btn.btn-secondary{href: '#', title: 'Plan A'}
              %i.fa.fa-map-location.fa-fw
              %span.v2-index-card-secondary-label Plan A
            %button.btn.btn-danger{type: 'button'}
              %i.fa.fa-trash.fa-fw
              = t('all.verb.destroy')
      .v2-index-card
        .v2-index-card-main
          .v2-index-card-body
            .v2-index-card-header
              %h2.v2-index-card-title Livraison archivée
              .v2-index-card-badges
                %span.badge.text-bg-secondary= t('operations.statuses.historized')
            .v2-index-card-meta.text-muted
              %span 01/09/2026
        .v2-index-card-mid
          = render 'v2/shared/status_segments', counts: done_counts
          %span.operations-index-progress-label.text-muted= t('operations.index.stops_count', treated: 20, total: 20)
        .v2-index-card-actions.v2-index-card-actions--slots
          %a.btn.btn-secondary{href: '#'}
            %i.fa.fa-tower-broadcast.fa-fw
            = t('execution.open_tracking')
          .v2-index-card-secondary
            .dropdown
              %button.btn.btn-secondary.dropdown-toggle{type: 'button', data: { bs_toggle: 'dropdown' }, aria: { expanded: 'false' }}
                %i.fa.fa-download.fa-fw
                = t('operations.show.export')
              %ul.dropdown-menu
                %li
                  %a.dropdown-item{href: '#'}
                    %i.fa.fa-file-excel.fa-fw
                    = t('operations.show.export_spreadsheet')
                %li
                  %a.dropdown-item{href: '#'}
                    %i.fa.fa-file-zipper.fa-fw
                    = t('operations.show.export_archive')
            %button.btn.btn-danger{type: 'button'}
              %i.fa.fa-trash.fa-fw
              = t('all.verb.destroy')
