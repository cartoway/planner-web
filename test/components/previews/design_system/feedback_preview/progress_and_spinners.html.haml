.container.py-4
  %h1.h4.mb-4 Progress &amp; spinners
  %h2.h6.text-secondary.mb-2 Progress (geocoding-style)
  .progress.mb-4{:style => "max-width: 24rem;"}
    .progress-bar.bg-success{"aria-valuemax" => "100", "aria-valuemin" => "0", "aria-valuenow" => "72", :role => "progressbar", :style => "width: 72%;"} 72%
  %h2.h6.text-secondary.mb-2 Spinners
  .d-flex.align-items-center.gap-3.mb-0
    .spinner-border.text-primary{:role => "status"}
      %span.visually-hidden Loading…
    .spinner-grow.text-secondary{:role => "status"}
      %span.visually-hidden Loading…
    %button.btn.btn-primary{:disabled => "disabled", :type => "button"}
      %span.spinner-border.spinner-border-sm.me-1{"aria-hidden" => "true"}
      Saving…
