<div class="container py-4">
  <h1 class="h4 mb-4">Badges &amp; pills</h1>

  <p class="mb-3">
    <span class="badge text-bg-primary">Primary</span>
    <span class="badge text-bg-secondary">Secondary</span>
    <span class="badge text-bg-success">Success</span>
    <span class="badge rounded-pill text-bg-danger">Pill</span>
  </p>

  <h2 class="h6 text-secondary mb-2">Filter row (v2 <code>.search-filter-badge</code>)</h2>
  <div class="d-flex flex-wrap gap-2 align-items-center">
    <span class="search-filter-badge badge text-bg-light border">
      Status: active
      <a href="#" class="text-decoration-none ms-1" aria-label="Remove">&times;</a>
    </span>
    <span class="search-filter-badge badge text-bg-light border">
      Zone: centre
      <a href="#" class="text-decoration-none ms-1" aria-label="Remove">&times;</a>
    </span>
  </div>
</div>
