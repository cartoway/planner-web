<div class="container py-4">
  <h1 class="h4 mb-4">Alerts</h1>

  <div class="alert alert-primary" role="alert">Primary alert</div>
  <div class="alert alert-success" role="alert">Success — operation completed.</div>
  <div class="alert alert-warning" role="alert">Warning — please review.</div>
  <div class="alert alert-danger" role="alert">Danger — something went wrong.</div>
  <div class="alert alert-info small mb-3" role="status">
    <i class="fa fa-map fa-fw" aria-hidden="true"></i>
    Info compact (similar to map position hints on destination form).
  </div>

  <div class="alert alert-secondary alert-dismissible fade show mb-0" role="alert">
    Dismissible alert
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
