.container.py-4
  %h1.h4.mb-4 Badges &amp; pills
  %p.mb-3
    %span.badge.text-bg-primary Primary
    %span.badge.text-bg-secondary Secondary
    %span.badge.text-bg-success Success
    %span.badge.rounded-pill.text-bg-danger Pill
  %h2.h6.text-secondary.mb-2
    Filter row (v2
    = succeed ")" do
      %code .search-filter-badge
  .d-flex.flex-wrap.gap-2.align-items-center
    %span.search-filter-badge.badge.text-bg-light.border
      Status: active
      %a.text-decoration-none.ms-1{"aria-label" => "Remove", :href => "#"} ×
    %span.search-filter-badge.badge.text-bg-light.border
      Zone: centre
      %a.text-decoration-none.ms-1{"aria-label" => "Remove", :href => "#"} ×
