<div class="container py-4">
  <h1 class="h4 mb-4">Modal</h1>
  <p class="text-muted small mb-3">Same structure as bulk visits modal in <code>v2/destinations/_form</code>.</p>

  <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ds-modal-demo">
    Open modal
  </button>

  <div class="modal fade" id="ds-modal-demo" tabindex="-1" aria-labelledby="ds-modal-demo-title" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="ds-modal-demo-title">Modal title</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="mb-0">Body copy. Add forms or lists here.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Apply</button>
        </div>
      </div>
    </div>
  </div>
</div>
