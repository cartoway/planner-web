<div class="container py-4">
  <h1 class="h4 mb-4">Offcanvas</h1>

  <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#ds-offcanvas" aria-controls="ds-offcanvas">
    Open panel
  </button>

  <div class="offcanvas offcanvas-end" tabindex="-1" id="ds-offcanvas" aria-labelledby="ds-offcanvas-label">
    <div class="offcanvas-header border-bottom">
      <h2 class="offcanvas-title h5" id="ds-offcanvas-label">Side panel</h2>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <p class="text-muted small">Useful pattern for filters or mobile navigation.</p>
    </div>
  </div>
</div>
