<div class="container py-4">
  <h1 class="h4 mb-4">Pagination (list footer)</h1>
  <p class="text-muted small mb-3">v2 destinations frame uses a custom <code>ul.pagination</code> with <code>.btn.btn-default.btn-sm</code>; Bootstrap 5 native pagination below.</p>

  <nav aria-label="Page navigation">
    <ul class="pagination pagination-sm justify-content-center mb-4">
      <li class="page-item disabled"><span class="page-link">Previous</span></li>
      <li class="page-item active" aria-current="page"><span class="page-link">1</span></li>
      <li class="page-item"><a class="page-link" href="#">2</a></li>
      <li class="page-item"><a class="page-link" href="#">3</a></li>
      <li class="page-item"><a class="page-link" href="#">Next</a></li>
    </ul>
  </nav>

  <p class="small text-secondary mb-2">Legacy-style control strip (icon buttons)</p>
  <ul class="pagination pagination-sm justify-content-center mb-0">
    <li class="page-item">
      <button type="button" class="btn btn-secondary btn-sm disabled rounded-0 rounded-start">
        <i class="fa fa-chevron-left" aria-hidden="true"></i>
      </button>
    </li>
    <li class="page-item disabled">
      <span class="btn btn-secondary btn-sm disabled rounded-0 border-start-0">2 / 5</span>
    </li>
    <li class="page-item">
      <button type="button" class="btn btn-secondary btn-sm rounded-0 rounded-end border-start-0">
        <i class="fa fa-chevron-right" aria-hidden="true"></i>
      </button>
    </li>
  </ul>
</div>
