<div class="container py-4">
  <h1 class="h4 mb-4">Tables — compact &amp; hover</h1>

  <div class="table-responsive">
    <table class="table table-sm table-striped table-hover caption-top">
      <caption class="text-muted small">Caption for context</caption>
      <thead class="table-light">
        <tr>
          <th scope="col">#</th>
          <th scope="col">Vehicle</th>
          <th scope="col" class="text-end">Distance</th>
        </tr>
      </thead>
      <tbody>
        <tr><th scope="row">1</th><td>AB-123-CD</td><td class="text-end">42 km</td></tr>
        <tr><th scope="row">2</th><td>EF-456-GH</td><td class="text-end">18 km</td></tr>
      </tbody>
    </table>
  </div>
</div>
