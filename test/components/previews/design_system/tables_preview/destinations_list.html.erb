<div class="container-fluid py-4">
  <h1 class="h4 mb-2">Destinations list pattern</h1>
  <p class="text-muted small mb-3">
    Mirrors <code>v2/destinations/_list_frame</code>: toolbar row + <code>.table-responsive</code> +
    <code>.table.table-striped.table-condensed</code> (v2 compatibility class; pair with <code>.table-sm</code> in new markup if you migrate).
  </p>

  <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <button type="button" class="btn btn-primary btn-sm">
      <i class="fa fa-plus fa-fw" aria-hidden="true"></i>
      New destination
    </button>
    <span class="small text-muted">12 / 120 destinations</span>
  </div>

  <div class="table-responsive border rounded">
    <table class="table table-striped table-condensed mb-0">
      <thead>
        <tr>
          <th style="width: 2rem;" class="text-center" aria-label="Select"></th>
          <th>Name</th>
          <th>Address</th>
          <th>Ref</th>
          <th>Geo</th>
          <th>Visits</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="text-center align-middle"><input class="form-check-input m-0" type="checkbox" aria-label="Select row"></td>
          <td>Warehouse Nord</td>
          <td class="small">12 rue des Lilas, 75019 Paris</td>
          <td>WH-01</td>
          <td>92%</td>
          <td>3 visits</td>
          <td>
            <button type="button" class="btn btn-secondary btn-sm py-0 px-1" title="Edit">
              <i class="fa fa-pencil" aria-hidden="true"></i>
            </button>
          </td>
        </tr>
        <tr>
          <td class="text-center align-middle"><input class="form-check-input m-0" type="checkbox" aria-label="Select row"></td>
          <td>Shop Centre</td>
          <td class="small">5 av. République, 69002 Lyon</td>
          <td>—</td>
          <td>—</td>
          <td>1 visit</td>
          <td>
            <button type="button" class="btn btn-secondary btn-sm py-0 px-1" title="Edit">
              <i class="fa fa-pencil" aria-hidden="true"></i>
            </button>
          </td>
        </tr>
        <tr>
          <td colspan="7" class="text-center text-muted py-4">No destinations found</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
