.container.py-4
  %h1.h4.mb-4 Tables — compact &amp; hover
  .table-responsive
    %table.table.table-sm.table-striped.table-hover.caption-top
      %caption.text-muted.small Caption for context
      %thead.table-light
        %tr
          %th{:scope => "col"} #
          %th{:scope => "col"} Vehicle
          %th.text-end{:scope => "col"} Distance
      %tbody
        %tr
          %th{:scope => "row"} 1
          %td AB-123-CD
          %td.text-end 42 km
        %tr
          %th{:scope => "row"} 2
          %td EF-456-GH
          %td.text-end 18 km
