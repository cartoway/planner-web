<div class="container py-4">
  <h1 class="h4 mb-4">Input groups</h1>

  <div class="mb-3">
    <label class="form-label" for="ds-ig1">With leading icon (Bootstrap 5)</label>
    <div class="input-group">
      <span class="input-group-text"><i class="fa fa-map fa-fw" aria-hidden="true"></i></span>
      <input type="text" class="form-control" id="ds-ig1" placeholder="Address line" autocomplete="off">
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label" for="ds-ig2">Lat / Lng</label>
    <div class="input-group">
      <input type="text" class="form-control" placeholder="Latitude" aria-label="Latitude" autocomplete="off">
      <input type="text" class="form-control" placeholder="Longitude" aria-label="Longitude" autocomplete="off">
      <span class="input-group-text"><i class="fa fa-globe fa-fw" aria-hidden="true"></i></span>
    </div>
  </div>

  <div class="mb-0">
    <label class="form-label" for="ds-float">Floating label</label>
    <div class="form-floating">
      <input type="email" class="form-control" id="ds-float" placeholder="name@example.com" autocomplete="off">
      <label for="ds-float">Email</label>
    </div>
  </div>
</div>
