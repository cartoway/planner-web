<div class="container py-4">
  <h1 class="h4 mb-2">Checks &amp; switches</h1>
  <p class="text-muted small mb-3">
    For v2 styling, native range, and the shared <code>check_box</code> partial conventions, see the
    <strong>Range and checks</strong> preview group.
  </p>

  <div class="form-check mb-2">
    <input class="form-check-input" type="checkbox" value="" id="ds-check1" checked>
    <label class="form-check-label" for="ds-check1">Checked option</label>
  </div>
  <div class="form-check mb-4">
    <input class="form-check-input" type="checkbox" value="" id="ds-check2">
    <label class="form-check-label" for="ds-check2">Unchecked option</label>
  </div>

  <div class="form-check mb-2">
    <input class="form-check-input" type="radio" name="ds-radio" id="ds-radio1" checked>
    <label class="form-check-label" for="ds-radio1">Radio A</label>
  </div>
  <div class="form-check mb-4">
    <input class="form-check-input" type="radio" name="ds-radio" id="ds-radio2">
    <label class="form-check-label" for="ds-radio2">Radio B</label>
  </div>

  <div class="form-check form-switch mb-0">
    <input class="form-check-input" type="checkbox" role="switch" id="ds-switch1" checked>
    <label class="form-check-label" for="ds-switch1">Form switch (v2 destroy flags use similar markup)</label>
  </div>
</div>
