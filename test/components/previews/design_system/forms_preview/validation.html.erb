<div class="container py-4">
  <h1 class="h4 mb-4">Validation states</h1>

  <div class="mb-3">
    <label for="ds-valid" class="form-label">Valid</label>
    <input type="text" class="form-control is-valid" id="ds-valid" value="OK" autocomplete="off">
    <div class="valid-feedback">Looks good.</div>
  </div>

  <div class="mb-0">
    <label for="ds-invalid" class="form-label">Invalid</label>
    <input type="text" class="form-control is-invalid" id="ds-invalid" value="Bad" autocomplete="off">
    <div class="invalid-feedback">Please correct this field.</div>
  </div>
</div>
