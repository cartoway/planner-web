<div class="container py-4">
  <h1 class="h4 mb-4">Text fields</h1>

  <div class="mb-3">
    <label for="ds-name" class="form-label">Label</label>
    <input type="text" class="form-control" id="ds-name" placeholder="Placeholder" autocomplete="off">
    <div class="form-text">Helper text — use <code>.form-text</code> (Bootstrap 5) or legacy <code>.help-block</code> in v2 SCSS.</div>
  </div>

  <div class="mb-3">
    <label for="ds-readonly" class="form-label">Readonly</label>
    <input type="text" class="form-control" id="ds-readonly" value="Read-only value" readonly>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-md-6">
      <label class="form-label" for="ds-pc">Postal code</label>
      <input type="text" class="form-control" id="ds-pc" maxlength="17" autocomplete="off">
    </div>
    <div class="col-md-6">
      <label class="form-label" for="ds-city">City</label>
      <input type="text" class="form-control" id="ds-city" autocomplete="off">
    </div>
  </div>

  <div class="mb-0">
    <label for="ds-number" class="form-label">Number</label>
    <input type="number" class="form-control" id="ds-number" step="any" placeholder="0.00">
  </div>
</div>
