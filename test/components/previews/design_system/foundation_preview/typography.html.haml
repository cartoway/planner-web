.container.py-4
  %p.text-muted.small.mb-4 Font stack and scale match the Lookbook preview layout (Montserrat + 13px root where overrides apply).
  %h1.display-6.mb-3 Display 6
  %h1.mb-2 Heading 1
  %h2.h3.mb-2 Heading 2 (.h3)
  %h3.h5.text-secondary.mb-3 Heading 3 muted
  %p.lead.mb-3 Lead paragraph — short supporting line for a section.
  %p.mb-2
    Body text with a
    = succeed "," do
      %a{:href => "#"} link
    = succeed "," do
      %strong strong
    = succeed "," do
      %em emphasis
    = succeed "." do
      %code inline code
  %p.small.text-muted.mb-4
    Small muted helper copy (similar to
    %code .help-block
    in v2).
  %blockquote.blockquote.border-start.border-4.ps-3.mb-0
    %p Blockquote for callouts or citations.
    %footer.blockquote-footer Source label
