<div class="container py-4">
  <h1 class="h4 mb-4">Icon buttons &amp; toolbar</h1>
  <p class="text-muted small mb-3">Common v2 pattern: <code>.btn.btn-sm</code> + Font Awesome <code>.fa-fw</code>.</p>

  <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <%= link_to "#", class: "btn btn-primary btn-sm" do %>
      <i class="fa fa-plus fa-fw" aria-hidden="true"></i>
      New
    <% end %>
    <button type="button" class="btn btn-secondary btn-sm" title="Collapse list">
      <i class="fa fa-chevron-left" aria-hidden="true"></i>
    </button>
    <button type="button" class="btn btn-outline-secondary btn-sm" title="Edit">
      <i class="fa fa-pencil" aria-hidden="true"></i>
    </button>
    <button type="button" class="btn btn-light btn-sm" title="Action neutre (v2)">
      <i class="fa fa-refresh fa-fw" aria-hidden="true"></i>
      Actualiser
    </button>
  </div>

  <h2 class="h6 text-secondary mb-3">Icônes — <code>disabled</code></h2>
  <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <%= link_to "#", class: "btn btn-primary btn-sm disabled", tabindex: "-1", "aria-disabled": "true", role: "button" do %>
      <i class="fa fa-plus fa-fw" aria-hidden="true"></i>
      New
    <% end %>
    <button type="button" class="btn btn-secondary btn-sm" disabled title="Collapse list">
      <i class="fa fa-chevron-left" aria-hidden="true"></i>
    </button>
    <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Edit">
      <i class="fa fa-pencil" aria-hidden="true"></i>
    </button>
  </div>

  <div class="border rounded p-2 d-inline-flex align-items-center gap-2 bg-body-secondary">
    <span class="small text-muted me-1">Toolbar</span>
    <button type="button" class="btn btn-secondary btn-sm">
      <i class="fa fa-list fa-fw" aria-hidden="true"></i>
      Bulk
    </button>
    <button type="button" class="btn btn-secondary btn-sm">
      <i class="fa fa-angle-double-down fa-fw" aria-hidden="true"></i>
      Expand
    </button>
  </div>

  <div class="border rounded p-2 d-inline-flex align-items-center gap-2 bg-body-secondary mt-2">
    <span class="small text-muted me-1">Toolbar (disabled)</span>
    <button type="button" class="btn btn-secondary btn-sm" disabled>
      <i class="fa fa-list fa-fw" aria-hidden="true"></i>
      Bulk
    </button>
    <button type="button" class="btn btn-secondary btn-sm" disabled>
      <i class="fa fa-angle-double-down fa-fw" aria-hidden="true"></i>
      Expand
    </button>
  </div>
</div>
