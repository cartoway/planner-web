<div class="container-fluid py-3">
  <h1 class="h4 mb-3">Form sidebar chrome (flex)</h1>
  <p class="text-muted small mb-3">
    Approximates <code>.main.main--form-sidebar</code>: primary column + fixed-width aside with border and shadow.
  </p>

  <div class="d-flex border rounded overflow-hidden" style="min-height: 14rem;">
    <main class="flex-grow-1 p-3 bg-body">
      <p class="small text-muted mb-0">Map or main content area (<code>.main-primary</code>).</p>
    </main>
    <aside class="border-start bg-body shadow-sm d-flex flex-column" style="flex: 0 0 min(320px, 36vw); max-width: 420px;">
      <div class="p-2 border-bottom small fw-semibold d-flex justify-content-between align-items-center">
        <span>Destination</span>
        <button type="button" class="btn btn-close" title="Close" aria-label="Close"></button>
      </div>
      <div class="p-3 overflow-auto flex-grow-1">
        <div class="mb-3">
          <label class="form-label" for="ds-fs-name">Name</label>
          <input type="text" class="form-control form-control-sm" id="ds-fs-name" autocomplete="off">
        </div>
        <button type="button" class="btn btn-primary btn-sm">Save</button>
      </div>
    </aside>
  </div>
</div>
