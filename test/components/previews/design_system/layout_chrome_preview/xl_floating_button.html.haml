.container-fluid.py-3
  %h1.h4.mb-3 XL floating button
  %p.text-muted.small.mb-4
    Map overlay CTA —
    %code .floating-btn.xl-floating-button
    \ with icon + label (e.g. destinations position-drag cancel).

  %h2.h6.text-secondary.mb-2 Default
  .d-flex.flex-wrap.align-items-center.gap-3.mb-4
    %button.floating-btn.xl-floating-button{type: 'button', title: t('destinations.index.cancel_position_drag'), 'aria-label': t('destinations.index.cancel_position_drag')}
      %i.fa.fa-times{"aria-hidden": "true"}
      %span.floating-label= t('destinations.index.cancel_position_drag')

  %h2.h6.text-secondary.mb-2 Compared to standard floating control
  .d-flex.flex-wrap.align-items-center.gap-3
    %button.floating-btn{type: 'button', title: t('destinations.index.expand_list', default: 'Show list'), 'aria-label': t('destinations.index.expand_list', default: 'Show list')}
      %i.fa.fa-chevron-right.fa-fw{"aria-hidden": "true"}
    %button.floating-btn.xl-floating-button{type: 'button', title: t('destinations.index.cancel_position_drag'), 'aria-label': t('destinations.index.cancel_position_drag')}
      %i.fa.fa-times{"aria-hidden": "true"}
      %span.floating-label= t('destinations.index.cancel_position_drag')
